"""
A Deno project rooted at a workspace-relative path.
"""
type DenoProject {
  """
  Project root, relative to the workspace.
  """
  path: String!

  # For a member of a Deno workspace this is the directory holding the root
  # deno.json whose `workspace` array lists this member. Commands run from there
  # so the shared deno.lock, import map, and sibling members resolve.
  """
  Root of the Deno workspace this project belongs to, or its own path.
  """
  workspaceRoot: String!

  """
  Base container carrying the Deno toolchain, inherited from the Deno root.
  """
  let base: Container!

  """
  Deno version configured on the root, used to gate version-specific flags.
  """
  let version: String!

  """
  This project's deno.json / deno.jsonc file.
  """
  config(ws: Workspace!): File! {
    let dir = ws.directory("/" + path)
    if (dir.glob("deno.jsonc").length > 0) {
      dir.file("deno.jsonc")
    } else {
      dir.file("deno.json")
    }
  }

  """
  This project's source directory.
  """
  source(ws: Workspace!): Directory! {
    ws.directory("/" + path, exclude: [".git", "**/node_modules"])
  }

  """
  Container with the Deno toolchain and this project at the workdir.
  """
  container(ws: Workspace!): Container! {
    # A standalone project mounts its own subtree. A workspace member mounts the
    # whole workspace root with the workdir at the member, so `deno` walks up to
    # the shared deno.lock, import map, and sibling members while still scoping
    # each command to this member.
    let rel = if (path == workspaceRoot) { "" } else {
      path.trimPrefix(workspaceRoot + "/")
    }
    let workdir = if (rel == "") { "/src" } else { "/src/" + rel }
    base
      .withEnvVariable("DENO_DIR", "/deno-dir")
      .withMountedCache("/deno-dir", cacheVolume("deno-cache"))
      .withDirectory(
        "/src",
        ws.directory("/" + workspaceRoot, exclude: [".git", "**/node_modules"]),
      )
      .withWorkdir(workdir)
  }

  """
  Lint this project with `deno lint`.
  """
  lint(ws: Workspace!): Void @check {
    exec(ws, "lint").sync
    null
  }

  """
  Run this project's tests with `deno test`.
  """
  test(ws: Workspace!): Void @check {
    exec(ws, "test").sync
    null
  }

  """
  Type-check this project with `deno check`.
  """
  typeCheck(ws: Workspace!): Void @check {
    exec(ws, "typeCheck").sync
    null
  }

  """
  Check this project's formatting with `deno fmt --check`.
  """
  formatCheck(ws: Workspace!): Void @check {
    exec(ws, "formatCheck").sync
    null
  }

  """
  Format this project with `deno fmt`.
  """
  format(ws: Workspace!): Changeset! @generate {
    let dir = cwdDir(ws)
    let before = directory.withDirectory(dir, source(ws))
    let after = directory.withDirectory(dir, formatted(ws))
    after.changes(before)
  }

  """
  Compile a standalone executable with `deno compile`.
  """
  compile(
    ws: Workspace!,
    entrypoint: String! = "main.ts",
    outputName: String! = "app",
    """
    Target triple to cross-compile for, e.g. "x86_64-unknown-linux-gnu".
    """
    target: String = null,
  ): File! {
    # The binary's baked-in permissions come from deno.json's default permission
    # set via `-P`, as for `test`. Below Deno 2.5.0 (no `-P`) it gets none, rather
    # than forcing `-A` into a shipped artifact.
    let targetFlag = if (target == null) { [] } else { ["--target", target] }
    let permissionFlag = if (supportsPermissionSets) { ["-P"] } else { [] }
    let out = "/tmp/out/" + outputName
    container(ws)
      .withExec(["deno", "compile"] + permissionFlag + ["--output", out] + targetFlag + [entrypoint])
      .file(out)
  }

  """
  The `deno` command line for one of the checks, by function name.
  """
  let args(command: String!): [String!]! {
    if (command == "lint") {
      ["deno", "lint"]
    } else if (command == "test") {
      # --permit-no-files: a project with no test files is a pass, not an error.
      # -P applies deno.json's permission config (>= 2.5.0); older Deno has no
      # -P, so it gets -A (grant all) instead.
      let permissionFlag = if (supportsPermissionSets) { "-P" } else { "-A" }
      ["deno", "test", "--permit-no-files", permissionFlag]
    } else if (command == "typeCheck") {
      ["deno", "check", "."]
    } else if (command == "formatCheck") {
      ["deno", "fmt", "--check"]
    } else {
      raise "unknown Deno command: " + command
    }
  }

  let exec(ws: Workspace!, command: String!): Container! {
    container(ws).withExec(args(command))
  }

  """
  Error message from running one of the checks, or null when it passes.
  """
  let failure(ws: Workspace!, command: String!): String {
    { exec(ws, command).sync; null } rescue {
      err: Error => err.message
    }
  }

  """
  This project after `deno fmt`.
  """
  let formatted(ws: Workspace!): Directory! {
    container(ws).withExec(["deno", "fmt"]).directory(".")
  }

  """
  This project's path relative to the caller: the CLI applies a changeset from
  where the caller stands, not from the workspace root.
  """
  let cwdDir(ws: Workspace!): String! {
    let base = ws.cwd.trimPrefix("/").trimSuffix("/")
    if (path == base) {
      "."
    } else if (base == "" or base == ".") {
      path
    } else {
      path.trimPrefix(base + "/")
    }
  }

  """
  Numeric >= for two non-negative integer strings without leading zeros: the
  longer one is larger, and equal lengths compare lexically (which matches
  numeric order for same-width digits).
  """
  let numGte(a: String!, b: String!): Boolean! {
    let da = a.split("").length
    let db = b.split("").length
    if (da != db) { da > db } else { a >= b }
  }

  """
  Whether the configured Deno version supports config-file permission sets and
  the `-P` flag (added in Deno 2.5.0). Compares the version's major.minor via
  numGte (no numeric parsing needed).
  """
  let supportsPermissionSets: Boolean! {
    let parts = version.split(".")
    let major = parts[0] ?? "0"
    let minor = if (parts.length > 1) { parts[1] ?? "0" } else { "0" }
    # >= 2.5.0: major >= 3, or major == 2 and minor >= 5.
    if (numGte(major, "3")) {
      true
    } else if (major == "2") {
      numGte(minor, "5")
    } else {
      false
    }
  }
}
