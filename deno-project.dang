"""
A Deno project rooted at a workspace-relative path (a directory containing a
deno.json / deno.jsonc).
"""
type DenoProject {
  """
  Workspace-relative path of this project root.
  """
  pub path: String!

  """
  Workspace-relative path of the Deno workspace root this project belongs to.
  Equals `path` for a standalone project; for a member of a Deno workspace it is
  the directory holding the root deno.json (whose `workspace` array lists this
  member). Commands run from the workspace root so the shared deno.lock, import
  map, and sibling members resolve.
  """
  pub workspaceRoot: String!

  """
  Base container carrying the Deno toolchain, inherited from the Deno root
  (its resolved `toolchain`).
  """
  let base: Container!

  """
  This project's deno.json / deno.jsonc file.
  """
  pub config(ws: Workspace!): File! {
    let dir = ws.directory(path)
    if (dir.glob("deno.jsonc").length > 0) {
      dir.file("deno.jsonc")
    } else {
      dir.file("deno.json")
    }
  }

  """
  This project's source directory (its subtree of the workspace).
  """
  pub source(ws: Workspace!): Directory! {
    ws.directory(path, exclude: [".git", "**/node_modules"])
  }

  """
  Container with the Deno toolchain and the project mounted at the workdir. The
  base every verb builds on, and the extension point for downstream modules.

  For a standalone project the project subtree is mounted. For a workspace member
  the whole workspace root is mounted and the workdir is set to the member's
  subdirectory, so `deno` can walk up to the shared deno.lock, import map, and
  sibling members while still scoping each command to this member.
  """
  pub container(ws: Workspace!): Container! {
    let rel = if (path == workspaceRoot) { "" } else { path.trimPrefix(workspaceRoot + "/") }
    let workdir = if (rel == "") { "/src" } else { "/src/" + rel }
    base
      .withEnvVariable("DENO_DIR", "/deno-dir")
      .withMountedCache("/deno-dir", cacheVolume("deno-cache"))
      .withDirectory("/src", ws.directory(workspaceRoot, exclude: [".git", "**/node_modules"]))
      .withWorkdir(workdir)
  }

  """
  Lint this project (`deno lint`).
  """
  pub lint(ws: Workspace!): Void @check {
    container(ws).withExec(["deno", "lint"]).sync
    null
  }

  """
  Run this project's tests (`deno test`). Permissions are governed entirely by
  the project's deno.json (`test.permissions`, or a top-level set), activated with
  `-P` — there is no Dagger-side permission argument. The default toolchain always
  supports `-P` (config permission sets landed in Deno 2.5.0); override `base` only
  with a 2.5.0+ image.
  """
  pub test(ws: Workspace!): Void @check {
    # --permit-no-files: a project with no test files is a pass, not an error.
    # -P applies deno.json's permission config.
    container(ws).withExec(["deno", "test", "--permit-no-files", "-P"]).sync
    null
  }

  """
  Type-check the project without running it (`deno check`).
  """
  pub typeCheck(ws: Workspace!): Void @check {
    container(ws).withExec(["deno", "check", "."]).sync
    null
  }

  """
  Check formatting without writing (`deno fmt --check`).
  """
  pub formatCheck(ws: Workspace!): Void @check {
    container(ws).withExec(["deno", "fmt", "--check"]).sync
    null
  }

  """
  Format the project (`deno fmt`); returns the diff for review before writing.
  """
  pub format(ws: Workspace!): Changeset! @generate {
    let before = directory.withDirectory(path, source(ws))
    let formatted = container(ws).withExec(["deno", "fmt"]).directory(".")
    let after = directory.withDirectory(path, formatted)
    after.changes(before)
  }

  """
  Compile a standalone executable (`deno compile`). `target` cross-compiles
  (e.g. "x86_64-unknown-linux-gnu"); null uses the base image's platform.

  The binary's baked-in permissions come from the project's deno.json default
  permission set (top-level `permissions.default`) via `-P`, mirroring `test` —
  there is no Dagger-side permission argument.
  """
  pub compile(
    ws: Workspace!,
    entrypoint: String! = "main.ts",
    outputName: String! = "app",
    target: String = null,
  ): File! {
    let targetFlag = if (target == null) { [] } else { ["--target", target] }
    let out = "/tmp/out/" + outputName
    container(ws)
      .withExec(["deno", "compile", "-P", "--output", out] + targetFlag + [entrypoint])
      .file(out)
  }
}
