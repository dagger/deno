"""
A Deno project rooted at a workspace-relative path.
"""
type DenoProject {
  """
  Project root, relative to the workspace.
  """
  path: String!

  # For a member of a Deno workspace this is the directory holding the root
  # deno.json whose `workspace` array lists this member. Commands run from there
  # so the shared deno.lock, import map, and sibling members resolve.
  """
  Root of the Deno workspace this project belongs to, or its own path.
  """
  workspaceRoot: String!

  """
  The Deno toolchain and settings this project runs with.
  """
  let tool: Deno!

  """
  This project's deno.json / deno.jsonc file.
  """
  config(ws: Workspace!): File! {
    let dir = ws.directory("/" + path)
    if (dir.glob("deno.jsonc").length > 0) {
      dir.file("deno.jsonc")
    } else {
      dir.file("deno.json")
    }
  }

  """
  This project's source directory.
  """
  source(ws: Workspace!): Directory! {
    ws.directory("/" + path, exclude: [".git", "**/node_modules"])
  }

  """
  Container with the Deno toolchain and this project at the workdir.
  """
  container(ws: Workspace!): Container! {
    # A standalone project mounts its own subtree. A workspace member mounts the
    # whole workspace root with the workdir at the member, so `deno` walks up to
    # the shared deno.lock, import map, and sibling members.
    let workdir = if (member == "") { "/src" } else { "/src/" + member }
    tool.mounted(ws, workspaceRoot).withWorkdir(workdir)
  }

  """
  This member's directory relative to its workspace root, or "" for a
  standalone project.
  """
  let member: String! {
    if (path == workspaceRoot) {
      ""
    } else if (workspaceRoot == ".") {
      path
    } else {
      path.trimPrefix(workspaceRoot + "/")
    }
  }

  """
  Lint this project with `deno lint`.
  """
  lint(ws: Workspace!): Void @check {
    exec(ws, "lint").sync
    null
  }

  """
  Run this project's tests with `deno test`.
  """
  test(ws: Workspace!): Void @check {
    exec(ws, "test").sync
    null
  }

  """
  Type-check this project with `deno check`.
  """
  typeCheck(ws: Workspace!): Void @check {
    exec(ws, "typeCheck").sync
    null
  }

  """
  Check this project's formatting with `deno fmt --check`.
  """
  formatCheck(ws: Workspace!): Void @check {
    exec(ws, "formatCheck").sync
    null
  }

  """
  Format this project with `deno fmt`.
  """
  format(ws: Workspace!): Changeset! @generate {
    scoped(ws, formatted(ws)).changes(scoped(ws, source(ws)))
  }

  """
  Compile a standalone executable with `deno compile`.
  """
  compile(
    ws: Workspace!,
    entrypoint: String! = "main.ts",
    outputName: String! = "app",
    """
    Target triple to cross-compile for, e.g. "x86_64-unknown-linux-gnu".
    """
    target: String = null,
  ): File! {
    # The binary's baked-in permissions follow the `permissions` setting, as for
    # `test`: by default deno.json's default permission set via `-P`. Below Deno
    # 2.5.0 (no `-P`) it gets none, rather than forcing `-A` into a shipped
    # artifact.
    let targetFlag = if (target == null) { [] } else { ["--target", target] }
    let permissionFlag = tool.permissionFlags(true)
    let out = "/tmp/out/" + outputName
    container(ws)
      .withExec(["deno", "compile"] + permissionFlag + ["--output", out] + targetFlag + [entrypoint])
      .file(out)
  }

  """
  Run one of the checks. A workspace member's commands run from the workspace
  root, scoped to the member's directory, the way `deno test <member>` does in
  the workspace's own CI: tests that expect the root as their cwd still pass.
  """
  let exec(ws: Workspace!, command: String!): Container! {
    tool.mounted(ws, workspaceRoot).withExec(tool.command(command, member))
  }

  """
  Error message from running one of the checks, or null when it passes.
  """
  let failure(ws: Workspace!, command: String!): String {
    { exec(ws, command).sync; null } rescue {
      err: Error => err.message
    }
  }

  """
  This project after `deno fmt`.
  """
  let formatted(ws: Workspace!): Directory! {
    tool
      .mounted(ws, workspaceRoot)
      .withExec(tool.command("format", member))
      .directory(if (member == "") { "." } else { member })
  }

  """
  A tree of this project (its source, or its formatted output) as seen from the
  caller: the CLI applies a changeset from where the caller stands, not from the
  workspace root. From inside the project, only the part under the caller can be
  represented, so that is what is kept.
  """
  let scoped(ws: Workspace!, tree: Directory!): Directory! {
    let base = ws.cwd.trimPrefix("/").trimSuffix("/")
    if (base == "" or base == ".") {
      directory.withDirectory(path, tree)
    } else if (path == base) {
      tree
    } else if (path.hasPrefix(base + "/")) {
      directory.withDirectory(path.trimPrefix(base + "/"), tree)
    } else if (path == ".") {
      tree.directory(base)
    } else {
      tree.directory(base.trimPrefix(path + "/"))
    }
  }
}
