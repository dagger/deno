"""
A Dagger module for Deno — a secure runtime for JavaScript and TypeScript.

https://deno.com
"""
type Deno {
  """
  Deno version used for the default base image. Defaults to a release that
  supports config-file permission sets (`deno test -P`, added in 2.5.0). Older
  overrides still work: `test` falls back to `-A` (grant all) below 2.5.0.
  """
  pub version: String! = "2.9.3"

  """
  Base container for Deno commands. Defaults to denoland/deno:alpine-<version>
  with the DENO_DIR cache configured. Override to bring your own image — it must
  have `deno` on PATH, or pass it through `install` first.
  """
  pub base: Container! =
    container
      .from("denoland/deno:alpine-" + version)
      .withoutEntrypoint
      .withEnvVariable("DENO_NO_UPDATE_CHECK", "1")

  """
  Install the Deno CLI and DENO_DIR cache into a container and return it. Copies
  the `deno` binary from denoland/deno:bin-<version>; use it to add Deno to a
  base that doesn't already have it (a glibc image such as debian, ubuntu, or
  distroless/cc — the binary is glibc-linked, so for musl/alpine use the default
  `base` instead).
  """
  pub install(ctr: Container!): Container! {
    let denoBin = container.from("denoland/deno:bin-" + version).file("/deno")
    ctr
      # 493 == 0o755; Dang has no octal literals.
      .withFile("/usr/local/bin/deno", denoBin, permissions: 493)
      .withEnvVariable("DENO_DIR", "/deno-dir")
      .withMountedCache("/deno-dir", cacheVolume("deno-cache"))
  }

  """
  The Deno project containing `path`. With findUp (default) `path` may be any
  directory inside a project and snaps to its root (the nearest deno.json /
  deno.jsonc); set findUp: false when `path` is already a project root.

  If the project is a member of a Deno workspace, its workspace root is resolved
  so commands run with the shared deno.lock, import map, and sibling members.
  """
  pub project(ws: Workspace!, path: String!, findUp: Boolean! = true): DenoProject! {
    let projectPath = if (findUp) {
      findProjectRoot(ws, path)
    } else {
      path
    }
    DenoProject(
      path: projectPath,
      workspaceRoot: findWorkspaceRoot(ws, projectPath) ?? projectPath,
      base: base,
      version: version,
    )
  }

  """
  The Deno workspace containing `path` (a directory whose deno.json declares a
  `workspace` array). With findUp (default) `path` may be any directory inside
  the workspace and snaps up to the root; set findUp: false when `path` is
  already the workspace root.
  """
  pub workspace(ws: Workspace!, path: String!, findUp: Boolean! = true): DenoWorkspace! {
    let root = if (findUp) {
      let found = findWorkspaceRoot(ws, normalizePath(path))
      if (found == null) {
        raise "no Deno workspace (deno.json with a `workspace` array) found containing path: " + path
      } else {
        found
      }
    } else {
      path
    }
    DenoWorkspace(path: root, base: base, version: version)
  }

  """
  Every Deno workspace discovered: each directory whose deno.json / deno.jsonc
  declares a `workspace` array (excluding node_modules).
  """
  pub workspaces(ws: Workspace!): [DenoWorkspace!]! {
    configDirs(ws)
      .filter { dir => isWorkspaceRoot(ws, dir) }
      .map { dir => DenoWorkspace(path: dir, base: base, version: version) }
  }

  """
  Every standalone Deno project discovered: each directory with a deno.json /
  deno.jsonc that is neither a workspace root nor a member of one (those are
  reached through `workspaces` / a workspace's `members`). node_modules is
  excluded.
  """
  pub projects(ws: Workspace!): [DenoProject!]! {
    let dirs = configDirs(ws)
    let roots = dirs.filter { dir => isWorkspaceRoot(ws, dir) }
    dirs
      .filter { dir => roots.contains(dir) == false }
      .filter { dir => roots.any { root => underRoot(dir, root) } == false }
      .map { dir => DenoProject(path: dir, workspaceRoot: dir, base: base, version: version) }
  }

  """
  Whether a discovered directory is in the caller's cone (its own project plus
  descendants), as opposed to an ancestor reached by walking up ("..", "../..").
  The workspace-wide verbs run on the cone only; ancestors are listed by
  `projects` / `workspaces` but never checked or formatted from here.
  """
  let inCone(dir: String!): Boolean! {
    dir.hasPrefix("..") == false
  }

  """
  The discovered workspaces in the caller's cone (excluding ancestors).
  """
  let coneWorkspaces(ws: Workspace!): [DenoWorkspace!]! {
    workspaces(ws).filter { w => inCone(w.path) }
  }

  """
  The discovered standalone projects in the caller's cone (excluding ancestors).
  """
  let coneProjects(ws: Workspace!): [DenoProject!]! {
    projects(ws).filter { p => inCone(p.path) }
  }

  """
  Lint every workspace and standalone project in the caller's cone (`deno lint`).
  """
  pub lintAll(ws: Workspace!): Void @check {
    coneWorkspaces(ws).each { w => w.lint(ws) }
    coneProjects(ws).each { p => p.lint(ws) }
    null
  }

  """
  Test every workspace and standalone project in the caller's cone (`deno test`).
  """
  pub testAll(ws: Workspace!): Void @check {
    coneWorkspaces(ws).each { w => w.test(ws) }
    coneProjects(ws).each { p => p.test(ws) }
    null
  }

  """
  Type-check every workspace and standalone project in the caller's cone
  (`deno check`).
  """
  pub typeCheckAll(ws: Workspace!): Void @check {
    coneWorkspaces(ws).each { w => w.typeCheck(ws) }
    coneProjects(ws).each { p => p.typeCheck(ws) }
    null
  }

  """
  Check formatting of every workspace and standalone project in the caller's cone
  (`deno fmt --check`).
  """
  pub formatCheckAll(ws: Workspace!): Void @check {
    coneWorkspaces(ws).each { w => w.formatCheck(ws) }
    coneProjects(ws).each { p => p.formatCheck(ws) }
    null
  }

  """
  Format every workspace and standalone project in the caller's cone (`deno fmt`);
  returns one changeset. Ancestor projects are excluded — a changeset rooted at
  the caller's location can't represent changes above it.
  """
  pub formatAll(ws: Workspace!): Changeset! @generate {
    let wsRoots = coneWorkspaces(ws)
    let projs = coneProjects(ws)
    let before = projs.reduce(
      wsRoots.reduce(directory) { acc, w => acc.withDirectory(w.path, w.source(ws)) }
    ) { acc, p => acc.withDirectory(p.path, p.source(ws)) }
    let afterWorkspaces = wsRoots.reduce(before) { acc, w =>
      acc.withDirectory(w.path, w.container(ws).withExec(["deno", "fmt"]).directory("."))
    }
    let after = projs.reduce(afterWorkspaces) { acc, p =>
      acc.withDirectory(p.path, p.container(ws).withExec(["deno", "fmt"]).directory("."))
    }
    after.changes(before)
  }

  """
  Every directory in the workspace that holds a deno.json / deno.jsonc.
  """
  let configDirs(ws: Workspace!): [String!]! {
    let src = ws.directory(
      ".",
      include: ["**/deno.json", "**/deno.jsonc"],
      exclude: ["**/node_modules/**"],
    )
    let descendants = (src.glob("**/deno.json") + src.glob("**/deno.jsonc"))
      .map { cfg => configDir(cfg) }
    (descendants + ancestorConfigDirs(ws)).uniq
  }

  """
  Ancestor directories of the current location that hold a deno.json / deno.jsonc,
  walking up to the workspace root, expressed relative to the current location
  ("..", "../..", …). This is how discovery from inside a subdirectory still sees
  the projects it lives under.
  """
  let ancestorConfigDirs(ws: Workspace!): [String!]! {
    let cwd = ws.cwd.trimPrefix("/").trimSuffix("/")
    if (cwd == "") {
      []
    } else {
      collectAncestors(ws, "..", cwd.split("/").length)
    }
  }

  """
  Walk `remaining` levels up from the current location (starting at `rel`),
  collecting each ancestor directory that holds a deno.json / deno.jsonc.
  """
  let collectAncestors(ws: Workspace!, rel: String!, remaining: Int!): [String!]! {
    if (remaining <= 0) {
      []
    } else {
      let d = ws.directory(rel)
      let hasConfig = d.glob("deno.json").length > 0 or d.glob("deno.jsonc").length > 0
      let here = if (hasConfig) { [rel] } else { [] }
      here + collectAncestors(ws, rel + "/..", remaining - 1)
    }
  }

  """
  Directory holding a discovered deno.json / deno.jsonc (workspace-relative).
  """
  let configDir(cfgPath: String!): String! {
    let dir = cfgPath.trimSuffix("/deno.jsonc").trimSuffix("/deno.json")
    if (dir == cfgPath) { "." } else { dir }
  }

  """
  Contents of the deno.json / deno.jsonc at `dir`, or "" when neither exists.
  """
  let configText(ws: Workspace!, dir: String!): String! {
    let d = ws.directory(dir)
    if (d.glob("deno.jsonc").length > 0) {
      d.file("deno.jsonc").contents
    } else if (d.glob("deno.json").length > 0) {
      d.file("deno.json").contents
    } else {
      ""
    }
  }

  """
  Whether the deno.json / deno.jsonc at `dir` declares a non-empty `workspace`
  array (i.e. `dir` is a Deno workspace root).
  """
  let isWorkspaceRoot(ws: Workspace!, dir: String!): Boolean! {
    let text = configText(ws, dir)
    if (text == "") {
      false
    } else {
      try {
        let cfg: DenoConfig! = JSON.decode(text)
        cfg.workspace.length > 0
      } catch {
        # deno.jsonc with comments/trailing commas isn't strict JSON; fall back
        # to a presence check on the `workspace` key.
        err => text.contains("\"workspace\"")
      }
    }
  }

  """
  Whether `dir` sits inside the workspace rooted at `root`.
  """
  let underRoot(dir: String!, root: String!): Boolean! {
    if (root == ".") {
      dir != "."
    } else {
      dir == root or dir.hasPrefix(root + "/")
    }
  }

  """
  Normalize a workspace-relative path: strip leading/trailing slashes, "" -> ".".
  """
  let normalizePath(path: String!): String! {
    let p = path.trimPrefix("/").trimSuffix("/")
    if (p == "") { "." } else { p }
  }

  """
  Parent directory of a workspace-relative path (".", for a top-level dir).
  """
  let parentDir(dir: String!): String! {
    let parts = dir.split("/")
    if (parts.length <= 1) { "." } else { parts.dropLast(1).join("/") }
  }

  """
  Nearest ancestor-or-self of `dir` that is a Deno workspace root, or null when
  `dir` belongs to no workspace.
  """
  let findWorkspaceRoot(ws: Workspace!, dir: String!): String {
    if (isWorkspaceRoot(ws, dir)) {
      dir
    } else if (dir == ".") {
      null
    } else {
      findWorkspaceRoot(ws, parentDir(dir))
    }
  }

  """
  Resolve the project root (directory containing deno.json/deno.jsonc) that
  contains `path`, walking up the workspace tree.
  """
  let findProjectRoot(ws: Workspace!, path: String!): String! {
    let found = ws.findUp("deno.json", path) ?? ws.findUp("deno.jsonc", path)
    if (found == null) {
      raise "no Deno project (deno.json/deno.jsonc) found containing path: " + path
    } else {
      let p = found.trimPrefix("/")
      if (p == "deno.json" or p == "deno.jsonc") {
        "."
      } else {
        p.trimSuffix("/deno.json").trimSuffix("/deno.jsonc")
      }
    }
  }
}

"""
Partial view of a deno.json / deno.jsonc used for workspace discovery: only the
`workspace` array (the list of monorepo member paths) is decoded.
"""
type DenoConfig {
  pub workspace: [String!]! = []
}
