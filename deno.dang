"""
Lint, test, type-check and format Deno projects and workspaces.

https://deno.com
"""
type Deno {
  """
  Deno version for the default base image, when set. Unset, the version comes
  from the nearest .dvmrc at or above each project, else a built-in fallback.
  """
  version: String

  """
  Base container for Deno commands, when set. Must have `deno` on PATH. Unset,
  denoland/deno:alpine-<version>.
  """
  base: Container

  """
  Permissions `test` and `compile` run with: "config", "all" or "none".
  """
  permissions: String!

  """
  Extra `deno test` flags, e.g. ["--doc", "--parallel"].
  """
  testArgs: [String!]!

  """
  Extra `deno check` flags, e.g. ["--allow-import"].
  """
  typeCheckArgs: [String!]!

  """
  What `type-check` checks, relative to each project or workspace root.
  """
  typeCheckTargets: [String!]!

  new(
    """
    Deno version for the default base image (denoland/deno:alpine-<version>).
    Takes precedence over .dvmrc. Unset, each project uses the nearest .dvmrc
    at or above it, else the module's fallback version.
    """
    version: String = null,
    """
    Base container for Deno commands. Must have `deno` on PATH.
    """
    base: Container = null,
    """
    Permissions `test` and `compile` run with: "config" uses the deno.json
    permission sets (-P), "all" grants everything (-A), "none" grants nothing.
    """
    permissions: String! = "config",
    """
    Extra `deno test` flags, e.g. ["--doc", "--parallel", "--ignore=_tools/"].
    """
    testArgs: [String!]! = [],
    """
    Extra `deno check` flags, e.g. ["--allow-import"].
    """
    typeCheckArgs: [String!]! = [],
    """
    What `type-check` checks, relative to each project or workspace root, e.g.
    ["mod.ts"]. The config's `exclude` still applies.
    """
    typeCheckTargets: [String!]! = ["."],
  ) {
    # Both stay null when unset: the version can only be resolved against a
    # workspace (its .dvmrc), which each function receives, so the default
    # image is built per call in `toolchainAt` rather than here.
    self.version = version
    self.base = base
    # A string rather than an enum: enum settings can't be read from dagger.toml.
    if (["config", "all", "none"].contains(permissions) == false) {
      raise "permissions must be \"config\", \"all\" or \"none\", got: " + permissions
    }
    self.permissions = permissions
    self.testArgs = testArgs
    self.typeCheckArgs = typeCheckArgs
    self.typeCheckTargets = typeCheckTargets
    self
  }

  """
  The Deno version used at a workspace path: the `version` setting, else the
  nearest .dvmrc at or above the path, else the module's fallback version.
  """
  toolchainVersion(ws: Workspace!, path: String! = "."): String! {
    versionAt(ws, resolvePath(ws, path))
  }

  """
  The container Deno commands run in at a workspace path: `base` if set,
  otherwise denoland/deno:alpine-<toolchainVersion>.
  """
  toolchain(ws: Workspace!, path: String! = "."): Container! {
    toolchainAt(ws, resolvePath(ws, path))
  }

  """
  Install the Deno CLI and cache into a glibc-based container, at the version
  `toolchainVersion` resolves for `path`.
  """
  install(ctr: Container!, ws: Workspace!, path: String! = "."): Container! {
    # The denoland/deno:bin binary is glibc-linked, so for musl/alpine use the
    # default `toolchain` instead.
    let denoBin = container
      .from("denoland/deno:bin-" + versionAt(ws, resolvePath(ws, path)))
      .file("/deno")
    ctr
      # 493 == 0o755; Dang has no octal literals.
      .withFile("/usr/local/bin/deno", denoBin, permissions: 493)
      .withEnvVariable("DENO_DIR", "/deno-dir")
      .withMountedCache("/deno-dir", cacheVolume("deno-cache"))
  }

  """
  The Deno version when neither the `version` setting nor a .dvmrc gives one.
  Not the setting's default, so that an unset setting can defer to .dvmrc.
  """
  let fallbackVersion: String! = "2.9.8"

  """
  The Deno version for a workspace-root-relative directory; see
  `toolchainVersion`.
  """
  let versionAt(ws: Workspace!, dir: String!): String! {
    version ?? dvmrcVersion(ws, dir) ?? fallbackVersion
  }

  """
  The version in the nearest .dvmrc at or above `dir` (workspace-relative), or
  null when there is none or it is blank. Like dvm, it reads the first line
  and drops a leading "v".
  """
  let dvmrcVersion(ws: Workspace!, dir: String!): String {
    let from = if (dir == "." or dir == "") { "/" } else { "/" + dir }
    let found = ws.findUp(".dvmrc", from)
    if (found == null) {
      null
    } else {
      let line = ws.file("/" + found.trimPrefix("/")).contents.trimSpace.split("\n")[0] ?? ""
      let v = line.trimSpace.trimPrefix("v")
      if (v == "") { null } else { v }
    }
  }

  """
  The container for a workspace-root-relative directory; see `toolchain`.
  """
  let toolchainAt(ws: Workspace!, dir: String!): Container! {
    base
      ?? container
        .from("denoland/deno:alpine-" + versionAt(ws, dir))
        .withoutEntrypoint
        .withEnvVariable("DENO_NO_UPDATE_CHECK", "1")
  }

  """
  The Deno project containing a workspace path.
  """
  project(ws: Workspace!, path: String!, findUp: Boolean! = true): DenoProject! {
    # With findUp, `path` may be any directory inside a project and snaps to its
    # root (the nearest deno.json / deno.jsonc). A member of a Deno workspace
    # resolves its workspace root, so commands run with the shared deno.lock,
    # import map, and sibling members.
    let projectPath = if (findUp) {
      findProjectRoot(ws, path)
    } else {
      resolvePath(ws, path)
    }
    projectAt(projectPath, findWorkspaceRoot(ws, projectPath) ?? projectPath)
  }

  """
  The Deno workspace containing a workspace path.
  """
  workspace(ws: Workspace!, path: String!, findUp: Boolean! = true): DenoWorkspace! {
    let root = if (findUp) {
      let found = findWorkspaceRoot(ws, resolvePath(ws, path))
      if (found == null) {
        raise "no Deno workspace (deno.json with a `workspace` array) found containing path: " + path
      } else {
        found
      }
    } else {
      resolvePath(ws, path)
    }
    workspaceAt(root)
  }

  """
  Deno workspaces at or around the working directory, keyed by workspace root.
  """
  workspaces(ws: Workspace!): DenoWorkspaces! {
    DenoWorkspaces(paths: workspaceRoots(ws, configDirs(ws)), tool: self)
  }

  """
  Standalone Deno projects at or around the working directory, keyed by project
  root.
  """
  projects(ws: Workspace!): DenoProjects! {
    # A standalone project is neither a workspace root nor a member of one;
    # those are reached through `workspaces`.
    let dirs = configDirs(ws)
    let roots = workspaceRoots(ws, dirs)
    let top = enclosingConfigDir(ws, dirs)
    DenoProjects(
      paths: dirs
        .filter { dir => roots.contains(dir) == false }
        .filter { dir => roots.any { root => underRoot(dir, root) } == false },
      # Every key is either outside a Deno workspace or a member of the one
      # enclosing the topmost config dir: a root at or below that would have
      # excluded it. Resolved once here, walking only the config files above.
      enclosingWorkspace: if (top == null) {
        null
      } else if (top == "." or roots.contains(top)) {
        null
      } else {
        findWorkspaceRoot(ws, parentDir(top))
      },
      tool: self,
    )
  }

  let projectAt(path: String!, workspaceRoot: String!): DenoProject! {
    DenoProject(path: path, workspaceRoot: workspaceRoot, tool: self)
  }

  let workspaceAt(path: String!): DenoWorkspace! {
    DenoWorkspace(path: path, tool: self)
  }

  """
  A container that runs the test report indexer, pinned apart from `version`
  and `base` so that every project's report is read by the same program.
  """
  let reportIndexer: Container! {
    container
      .from("denoland/deno:alpine-2.9.3")
      .withoutEntrypoint
      .withEnvVariable("DENO_NO_UPDATE_CHECK", "1")
      .withEnvVariable("NO_COLOR", "1")
      .withFile("/indexer/main.ts", currentModule.source.file("helpers/deno-test-report/main.ts"))
  }

  """
  The test files `deno test` runs from `root` when given `member` ("" for all
  of root): files named test.*, *_test.* or *.test.* with a JavaScript or
  TypeScript extension, outside node_modules and what the configs exclude.
  Directories below the scope with a config of their own are members of a
  `workspace`, whose configs' excludes apply; otherwise they are projects of
  their own, whose files are theirs. Listing runs no container.
  """
  let testFiles(
    ws: Workspace!,
    root: String!,
    member: String!,
    workspace: Boolean!,
  ): DenoTestFiles! {
    let scope = joinPath(root, member)
    let empty: [String!]! = []
    let configs = ws.directory(
      absolutePath(scope),
      include: ["**/deno.json", "**/deno.jsonc"],
      exclude: [".git", "**/node_modules"],
    )
    let configFiles = configs.glob("**/deno.json") + configs.glob("**/deno.jsonc")
    let dirs = configFiles.map { f => configDirOf(f) }.uniq
    let nested = dirs.filter { d => d != "." }
    let read = if (workspace) { dirs } else { dirs.filter { d => d == "." } }
    let excluded = read.reduce(empty) { all, d =>
      all + excludePatterns(configText(configs, configFiles, d)).map { p => joinPath(
        d,
        p,
      ) }
    } + (if (workspace) { empty } else { nested })
    let included = if (dirs.contains(".")) {
      includePatterns(configText(configs, configFiles, "."))
    } else {
      empty
    }
    let found = ws
      .directory(
        absolutePath(scope),
        include: ["**/test.*", "**/*_test.*", "**/*.test.*"],
        exclude: [".git", "**/node_modules"],
      )
      .glob("**/*test.*")
      .filter { f =>
        isTestFile(f)
          and excluded.any { p => pathMatches(f, p) } == false
          and (included.length == 0 or included.any { p => pathMatches(f, p) })
      }
    # A test file that registers no test of its own (an empty placeholder, one
    # that only imports tests) is no check, as go leaves out test files that
    # declare no test: deno would run it with nothing to report. One ripgrep
    # pass over the scope; should the search fail, every candidate stays and
    # the run reports what deno did with it.
    let registering = {
      ws
        .search(
          # Deno.test, and it/test/describe(.only|.skip|.ignore) as
          # @std/testing/bdd and node:test register them. Over-matching only
          # keeps a file.
          pattern: `Deno\.test|(it|test|describe)(\.[a-z]+)? *\(`,
          filesOnly: true,
          paths: [scope],
          globs: ["*test.*", "!**/node_modules", "!**/.git"],
        ).{{filePath}}
        .map { r => r.filePath.trimPrefix("/").trimPrefix("./") }
    } rescue ["*"]
    let declared = found.filter { f =>
      registering == ["*"] or registering.contains(joinPath(scope, f))
    }
    DenoTestFiles(
      paths: sorted(declared.map { f => joinPath(scope, f) }),
      root: root,
      member: member,
      holdsProjects: workspace == false and nested.length > 0,
      tool: self,
    )
  }

  """
  The config deno reads in `dir` of `configs`, which holds `files`: deno.json
  first, falling back to deno.jsonc.
  """
  let configText(configs: Directory!, files: [String!]!, dir: String!): String! {
    let json = joinPath(dir, "deno.json")
    # A config that can't be read adds no patterns: deno's own error, naming
    # the file, then fails that project's checks and no other's.
    let text = {
      configs.file(if (files.contains(json)) { json } else { joinPath(dir, "deno.jsonc") }).contents
    } rescue "{}"
    text
  }

  """
  Whether a path names a file `deno test` runs when it walks a directory.
  """
  let isTestFile(path: String!): Boolean! {
    path.replaceMatches(
      `^(?:.*/)?(?:[^/]*[._])?test\.(?:ts|tsx|mts|cts|js|jsx|mjs|cjs)$`,
      with: "",
    ) == ""
  }

  """
  The `exclude` and `test.exclude` patterns in config text, relative to its
  directory. Negations and patterns reaching outside it are left out.
  """
  let excludePatterns(text: String!): [String!]! {
    let empty: [String!]! = []
    let patterns = {
      let cfg: DenoConfig! = JSON.decode(stripJsonc(text))
      cfg.exclude + (if (cfg.test == null) { empty } else { cfg.test!.exclude })
    } rescue empty
    patterns.map { p => normalizePattern(p) }.filter { p => p != "" }
  }

  """
  The `test.include` patterns in config text, relative to its directory.
  """
  let includePatterns(text: String!): [String!]! {
    let empty: [String!]! = []
    let patterns = {
      let cfg: DenoConfig! = JSON.decode(stripJsonc(text))
      if (cfg.test == null) { empty } else { cfg.test!.include }
    } rescue empty
    patterns.map { p => normalizePattern(p) }.filter { p => p != "" }
  }

  """
  A config path pattern relative to its directory, or "" when it is one this
  module does not follow (a negation, or a path outside the directory).
  """
  let normalizePattern(pattern: String!): String! {
    let p = pattern.trimPrefix("./").trimSuffix("/")
    if (p == "" or p == "." or p.hasPrefix("!") or p.hasPrefix("/") or p.hasPrefix("..")) { "" } else { p }
  }

  """
  Whether a path is, or is below, what a config path or glob names.
  """
  let pathMatches(path: String!, pattern: String!): Boolean! {
    if (pattern.replaceMatches(`[*?\[{]`, with: "") == pattern) {
      path == pattern or path.hasPrefix(pattern + "/")
    } else {
      # A pattern that is no valid glob matches nothing, as deno would refuse it.
      { path.match(Regexp("^(?:" + globRegex(pattern) + ")(?:/.*)?$")) != null } rescue false
    }
  }

  """
  A glob as a regular expression: `**` crosses directories, `*` and `?` do
  not, and `{a,b}` is either.
  """
  let globRegex(glob: String!): String! {
    glob.rewriteMatches(`\*\*/|\*\*|\*|\?|\{|\}|,|[.+^$()|\\]`) { m =>
      let t = m.string
      if (t == "**/") {
        "(?:.*/)?"
      } else if (t == "**") {
        ".*"
      } else if (t == "*") {
        "[^/]*"
      } else if (t == "?") {
        "[^/]"
      } else if (t == "{") {
        "(?:"
      } else if (t == "}") {
        ")"
      } else if (t == ",") {
        "|"
      } else {
        "\\" + t
      }
    }
  }

  """
  Two workspace-relative paths joined, "." standing for the root.
  """
  let joinPath(dir: String!, rel: String!): String! {
    if (rel == "" or rel == ".") { dir } else if (dir == "" or dir == ".") { rel } else { dir + "/" + rel }
  }

  """
  A workspace-relative path as Workspace.directory takes it.
  """
  let absolutePath(path: String!): String! {
    if (path == "." or path == "") { "/" } else { "/" + path }
  }

  """
  Byte-order sort: a merge sort, n log n comparisons.
  """
  let sorted(items: [String!]!): [String!]! {
    if (items.length < 2) {
      items
    } else {
      let half = items.length / 2
      mergeSorted(sorted(items.takeFirst(half)), sorted(items.dropFirst(half)))
    }
  }

  """
  Two byte-ordered lists merged into one.
  """
  let mergeSorted(a: [String!]!, b: [String!]!): [String!]! {
    let i = 0
    let j = 0
    (a + b).map { unused =>
      if (j == b.length or (i < a.length and a[i]! <= b[j]!)) {
        let item = a[i]!
        i += 1
        item
      } else {
        let item = b[j]!
        j += 1
        item
      }
    }
  }

  """
  A container with the Deno toolchain and cache, and `dir` of the workspace
  mounted at /src as the workdir.
  """
  let mounted(ws: Workspace!, dir: String!): Container! {
    let toolchain = toolchainAt(ws, dir)
    let ctr = if (usesPermissionSets(versionAt(ws, dir))) {
      quietPermissionSets(toolchain)
    } else {
      toolchain
    }
    ctr
      .withEnvVariable("DENO_DIR", "/deno-dir")
      .withMountedCache("/deno-dir", cacheVolume("deno-cache"))
      .withDirectory(
        containerPath(dir),
        ws.directory("/" + dir, exclude: [".git", "**/node_modules"]),
      )
      # A test that uses a Dagger SDK opens a session from inside this
      # container, and a session finds its workspace root by walking up to a
      # .git directory. Without one it gets an empty workspace, so every
      # workspace-relative API fails there -- including the serveModule a
      # generated module client calls before its first query. The marker only
      # has to exist, so synthesize an empty one rather than uploading the real
      # git directory; a workspace built from a Directory has none to upload.
      .withDirectory("/src/.git", directory)
      .withWorkdir(containerPath(dir))
  }

  """
  A workspace-root-relative path as an absolute one in the container, which
  mirrors the workspace so that workspace-relative addresses resolve there.
  """
  let containerPath(p: String!): String! {
    if (p == "." or p == "") { "/src" } else { "/src/" + p }
  }

  """
  The `deno` command line for one of the checks (by function name) or
  "format", run from the mounted root. `target` scopes it to a workspace
  member's directory; "" runs it on the whole mount. `version` is the Deno
  version it runs on (see `versionAt`), which decides the permission flags.
  """
  let command(name: String!, target: String!, version: String!): [String!]! {
    let targets = if (target == "") { [] } else { [target] }
    if (name == "lint") {
      ["deno", "lint"] + targets
    } else if (name == "test") {
      # --permit-no-files: a project with no test files is a pass, not an error.
      ["deno", "test", "--permit-no-files"] + permissionFlags(false, version) + testArgs + targets
    } else if (name == "typeCheck") {
      ["deno", "check"] + typeCheckArgs + typeCheckTargets.map { t =>
        under(
          target,
          t,
        )
      }
    } else if (name == "formatCheck") {
      ["deno", "fmt", "--check"] + targets
    } else if (name == "format") {
      ["deno", "fmt"] + targets
    } else {
      raise "unknown Deno command: " + name
    }
  }

  """
  A path relative to `dir` ("" or "." for the mount root), as seen from the root.
  """
  let under(dir: String!, rel: String!): String! {
    let r = rel.trimPrefix("./").trimSuffix("/")
    if (dir == "" or dir == ".") {
      rel
    } else if (r == "." or r == "") {
      dir
    } else {
      dir + "/" + r
    }
  }

  """
  The permission flags for `deno test` (compile: false) or `deno compile`.
  "config" uses -P, which Deno added in 2.5.0: below it, test falls back to -A
  and compile to no flag, rather than bake grant-all into a shipped binary.
  """
  let permissionFlags(compile: Boolean!, version: String!): [String!]! {
    if (permissions == "all") {
      ["-A"]
    } else if (permissions == "none") {
      []
    } else if (supportsPermissionSets(version)) {
      ["-P"]
    } else if (compile) {
      []
    } else {
      ["-A"]
    }
  }

  """
  Whether `test` and `compile` pass `-P` on a Deno version.
  """
  let usesPermissionSets(version: String!): Boolean! {
    permissions == "config" and supportsPermissionSets(version)
  }

  """
  `ctr` with Deno's "Permissions in the config file is an experimental
  feature" warning silenced. Deno prints it on every `-P` run and has no flag
  for it short of `--quiet`, which also stops `deno test` echoing test output.
  It logs from the CLI's root module (target `deno`), so DENO_LOG lowers just
  that target to errors; `deno::` (every submodule) and `deno_` (the other
  crates) stay at info, the longer directive winning. Left alone when testArgs
  sets a log level, since DENO_LOG would override it.
  """
  let quietPermissionSets(ctr: Container!): Container! {
    let setsLogLevel = testArgs.any { a =>
      a == "-q" or a == "--quiet" or a == "-L" or a.hasPrefix("--log-level")
    }
    if (setsLogLevel) {
      ctr
    } else {
      ctr.withEnvVariable("DENO_LOG", "info,deno=error,deno::=info,deno_=info")
    }
  }

  """
  Numeric >= for two non-negative integer strings without leading zeros: the
  longer one is larger, and equal lengths compare lexically (which matches
  numeric order for same-width digits).
  """
  let numGte(a: String!, b: String!): Boolean! {
    let da = a.split("").length
    let db = b.split("").length
    if (da != db) { da > db } else { a >= b }
  }

  """
  Whether a Deno version supports config-file permission sets and the `-P` flag
  (added in Deno 2.5.0).
  """
  let supportsPermissionSets(version: String!): Boolean! {
    let parts = version.split(".")
    let major = parts[0] ?? "0"
    let minor = if (parts.length > 1) { parts[1] ?? "0" } else { "0" }
    # >= 2.5.0: major >= 3, or major == 2 and minor >= 5.
    if (numGte(major, "3")) {
      true
    } else if (major == "2") {
      numGte(minor, "5")
    } else {
      false
    }
  }

  """
  Whether a directory sits at or below the caller's location, as opposed to an
  enclosing one found by walking up.
  """
  let inCone(ws: Workspace!, dir: String!): Boolean! {
    let base = cwdPath(ws)
    base == "." or dir == base or dir.hasPrefix(base + "/")
  }

  """
  The discovered config directory at or above the caller's location (the
  project the caller stands in), or null when the caller is in no project.
  """
  let enclosingConfigDir(ws: Workspace!, dirs: [String!]!): String {
    let base = cwdPath(ws)
    let enclosing = dirs.filter { dir => dir == base or underRoot(base, dir) }
    enclosing[0]
  }

  """
  Every directory in the workspace that holds a deno.json / deno.jsonc, anchored
  at the caller's location: every project at or below it (walk-down), plus the
  nearest enclosing project when the caller's location is not itself a project
  root (find-up), excluding node_modules. Delegates to the
  cwd-aware `Workspace.findRoots`, which answers relative to the caller — walk-down
  hits as ".", "sub" and the find-up hit as "..", "../..". Those are resolved to
  workspace-root-relative paths, the one spelling that stays valid wherever the
  caller stands.
  """
  let configDirs(ws: Workspace!): [String!]! {
    ws
      .findRoots(
        markers: ["deno.json", "deno.jsonc"],
        exclude: ["**/node_modules/**"],
      )
      .map { dir => workspaceRootPath(ws, dir) }
  }

  """
  Workspace-root-relative path of the caller's location.
  """
  let cwdPath(ws: Workspace!): String! {
    normalizePath(ws.cwd)
  }

  """
  Resolve a path expressed relative to the caller's location into a
  workspace-root-relative one, collapsing any leading "..".
  """
  let workspaceRootPath(ws: Workspace!, cwdRelPath: String!): String! {
    let segments = cwdRelPath.split("/").filter { s => s != "" and s != "." }
    let up = segments.filter { s => s == ".." }.length
    let down = segments.filter { s => s != ".." }
    let resolved = ws.cwd.split("/").filter { s => s != "" }.dropLast(up) + down
    if (resolved.length == 0) { "." } else { resolved.join("/") }
  }

  """
  Resolve a caller-supplied path the way every other Dagger path argument
  resolves: relative to the caller's location, or to the workspace root when
  absolute.
  """
  let resolvePath(ws: Workspace!, path: String!): String! {
    if (path.hasPrefix("/")) {
      normalizePath(path)
    } else {
      workspaceRootPath(ws, path)
    }
  }

  """
  The discovered directories that are Deno workspace roots, in discovery order.
  One ripgrep pass over the caller's subtree finds the configs mentioning
  `workspace` (only those few are read); the enclosing directory found by
  walking up, if any, is checked on its own.
  """
  let workspaceRoots(ws: Workspace!, dirs: [String!]!): [String!]! {
    let below = ws
      .search(
        pattern: "\"workspace\"",
        literal: true,
        filesOnly: true,
        # Search paths are workspace-root-relative, unlike most Workspace paths.
        paths: [cwdPath(ws)],
        globs: ["deno.json", "deno.jsonc", "!**/node_modules", "!**/.git"],
      ).{{filePath}}
      .map { r => configDirOf(r.filePath.trimPrefix("/").trimPrefix("./")) }
      .uniq
      # Over-matching is fine: each candidate is decided from the config deno
      # actually reads there (deno.json before deno.jsonc), parsed properly.
      .filter { dir => isWorkspaceRoot(ws, dir) }
    dirs.filter { dir =>
      if (inCone(ws, dir)) { below.contains(dir) } else { isWorkspaceRoot(ws, dir) }
    }
  }

  """
  Whether the config file at a workspace-relative path declares a non-empty
  `workspace` array.
  """
  let isWorkspaceConfig(ws: Workspace!, file: String!): Boolean! {
    declaresWorkspace(ws.file("/" + file.trimPrefix("/")).contents)
  }

  """
  Whether deno.json / deno.jsonc text declares a non-empty `workspace` array.
  """
  let declaresWorkspace(text: String!): Boolean! {
    # A config that doesn't parse even as JSONC is not a workspace. Raising
    # here would fail listing for the whole Dagger workspace over one file;
    # instead the directory is keyed as a project, and its checks fail with
    # deno's own parse error, naming the file.
    {
      let cfg: DenoConfig! = JSON.decode(stripJsonc(text))
      cfg.workspace.length > 0
    } rescue false
  }

  """
  deno.jsonc text as strict JSON: comments dropped, trailing commas removed.
  A no-op on deno.json.
  """
  let stripJsonc(text: String!): String! {
    # One pass, string literals first in the alternation, so a `//` inside a
    # value (a URL in `imports`) is never read as a comment opener, and a
    # string such as "a,}" keeps its comma.
    text.rewriteMatches(`"(?:[^"\\]|\\.)*"|//[^\n]*|/\*(?s:.*?)\*/|,\s*[}\]]`) { m =>
      if (m.string.hasPrefix("\"")) {
        m.string
      } else if (m.string.hasPrefix(",")) {
        m.string.trimPrefix(",")
      } else {
        ""
      }
    }
  }

  """
  Directory holding a workspace-relative config file path.
  """
  let configDirOf(file: String!): String! {
    let p = file.trimPrefix("/")
    if (p == "deno.json" or p == "deno.jsonc") {
      "."
    } else {
      p.trimSuffix("/deno.jsonc").trimSuffix("/deno.json")
    }
  }

  """
  The nearest deno.json / deno.jsonc at or above `dir` (workspace-relative), or
  null. Two findUp calls, so no directory is listed or read.
  """
  let configFileAt(ws: Workspace!, dir: String!): String {
    let from = if (dir == ".") { "/" } else { "/" + dir }
    let json = ws.findUp("deno.json", from)
    let jsonc = ws.findUp("deno.jsonc", from)
    if (json == null) {
      jsonc
    } else if (jsonc == null) {
      json
    } else {
      # Both exist somewhere above: the deeper one is nearer. In the same
      # directory deno.json wins: deno reads it first and only falls back to
      # deno.jsonc.
      let jsonDir = configDirOf(json)
      let jsoncDir = configDirOf(jsonc)
      if (jsoncDir != jsonDir and underRoot(jsoncDir, jsonDir)) { jsonc } else { json }
    }
  }

  """
  Whether `dir` holds a deno.json / deno.jsonc declaring a non-empty `workspace`
  array (i.e. `dir` is a Deno workspace root).
  """
  let isWorkspaceRoot(ws: Workspace!, dir: String!): Boolean! {
    let file = configFileAt(ws, dir)
    if (file == null) {
      false
    } else {
      configDirOf(file) == dir and isWorkspaceConfig(ws, file)
    }
  }

  """
  Whether `dir` sits inside the workspace rooted at `root`.
  """
  let underRoot(dir: String!, root: String!): Boolean! {
    if (root == ".") {
      dir != "."
    } else {
      dir == root or dir.hasPrefix(root + "/")
    }
  }

  """
  Normalize a workspace-relative path: strip leading/trailing slashes, "" -> ".".
  """
  let normalizePath(path: String!): String! {
    let p = path.trimPrefix("/").trimSuffix("/")
    if (p == "") { "." } else { p }
  }

  """
  Parent directory of a workspace-relative path (".", for a top-level dir).
  """
  let parentDir(dir: String!): String! {
    let parts = dir.split("/")
    if (parts.length <= 1) { "." } else { parts.dropLast(1).join("/") }
  }

  """
  Nearest ancestor-or-self of `dir` that is a Deno workspace root, or null when
  `dir` belongs to no workspace. Hops between config files with findUp, so it
  reads one file per enclosing project rather than one per directory.
  """
  let findWorkspaceRoot(ws: Workspace!, dir: String!): String {
    let file = configFileAt(ws, dir)
    if (file == null) {
      null
    } else {
      let cfgDir = configDirOf(file)
      if (isWorkspaceConfig(ws, file)) {
        cfgDir
      } else if (cfgDir == ".") {
        null
      } else {
        findWorkspaceRoot(ws, parentDir(cfgDir))
      }
    }
  }

  """
  Resolve the project root (directory containing deno.json/deno.jsonc) that
  contains `path`, walking up the workspace tree. `path` is read the way the
  engine reads any path argument (relative to the caller).
  """
  let findProjectRoot(ws: Workspace!, path: String!): String! {
    let found = configFileAt(ws, resolvePath(ws, path))
    if (found == null) {
      raise "no Deno project (deno.json/deno.jsonc) found containing path: " + path
    } else {
      configDirOf(found)
    }
  }
}

"""
Standalone Deno projects in a workspace, keyed by project root.
"""
type DenoProjects @collection {
  """
  Project root paths.
  """
  paths: [String!]! @keys

  # The Deno workspace root enclosing the keys, if any (see `Deno.projects`).
  # Held instead of the Workspace, which would stop the collection caching.
  let enclosingWorkspace: String

  let tool: Deno!

  """
  A Deno project, keyed by its root; a workspace member runs from its workspace root.
  """
  project(path: String!): DenoProject! @get {
    tool.projectAt(path, enclosingWorkspace ?? path)
  }

  """
  Lint the selected Deno projects. A plain helper, not a check: `dagger check` runs
  each item's own `lint`.
  """
  lint(ws: Workspace!): Void {
    runAll(ws, "lint")
  }

  """
  Run tests in the selected Deno projects, one whole `deno test` each. A plain
  helper, not a check: `dagger check` runs one check per test file.
  """
  test(ws: Workspace!): Void {
    runAll(ws, "test")
  }

  """
  Type-check the selected Deno projects. A plain helper, not a check.
  """
  typeCheck(ws: Workspace!): Void {
    runAll(ws, "typeCheck")
  }

  """
  Check formatting of the selected Deno projects. A plain helper, not a check.
  """
  formatCheck(ws: Workspace!): Void {
    runAll(ws, "formatCheck")
  }

  """
  Format the selected Deno projects as one changeset. A plain helper, not a
  generator: `dagger generate` runs each item's own `format`.
  """
  format(ws: Workspace!): Changeset! {
    let items = paths.map { p => project(p) }
    let before = items.reduce(directory) { acc, p =>
      acc.withDirectory(".", p.scoped(ws, p.source(ws)))
    }
    let after = items.reduce(before) { acc, p =>
      acc.withDirectory(".", p.scoped(ws, p.formatted(ws)))
    }
    after.changes(before)
  }

  """
  Run one command in every selected project, then report each failure by path.
  """
  let runAll(ws: Workspace!, command: String!): Void {
    # A selection over a list evaluates its elements concurrently, so every
    # project's command runs in parallel.
    let failures = paths.map { p => project(p) }.{{path, failure(ws, command)}}
      .filter { result => result.failure != null }
    if (failures.length > 0) {
      raise "Deno " + command + " failed:\n" + failures.map { result =>
        "- " + result.path + ": " + (result.failure ?? "")
      }.join("\n")
    }
    null
  }
}

"""
Deno workspaces in a workspace, keyed by workspace root.
"""
type DenoWorkspaces @collection {
  """
  Workspace root paths.
  """
  paths: [String!]! @keys

  let tool: Deno!

  """
  A Deno workspace, keyed by its root; its checks cover every member.
  """
  workspace(path: String!): DenoWorkspace! @get {
    tool.workspaceAt(path)
  }

  """
  Lint the selected Deno workspaces. A plain helper, not a check: `dagger check` runs
  each item's own `lint`.
  """
  lint(ws: Workspace!): Void {
    runAll(ws, "lint")
  }

  """
  Run tests in the selected Deno workspaces, one whole `deno test` each. A plain
  helper, not a check: `dagger check` runs one check per test file.
  """
  test(ws: Workspace!): Void {
    runAll(ws, "test")
  }

  """
  Type-check the selected Deno workspaces. A plain helper, not a check.
  """
  typeCheck(ws: Workspace!): Void {
    runAll(ws, "typeCheck")
  }

  """
  Check formatting of the selected Deno workspaces. A plain helper, not a check.
  """
  formatCheck(ws: Workspace!): Void {
    runAll(ws, "formatCheck")
  }

  """
  Format the selected Deno workspaces as one changeset. A plain helper, not a
  generator: `dagger generate` runs each item's own `format`.
  """
  format(ws: Workspace!): Changeset! {
    let items = paths.map { p => workspace(p) }
    let before = items.reduce(directory) { acc, w =>
      acc.withDirectory(".", w.scoped(ws, w.source(ws)))
    }
    let after = items.reduce(before) { acc, w =>
      acc.withDirectory(".", w.scoped(ws, w.formatted(ws)))
    }
    after.changes(before)
  }

  """
  Run one command in every selected workspace, then report each failure by path.
  """
  let runAll(ws: Workspace!, command: String!): Void {
    let failures = paths.map { p => workspace(p) }.{{path, failure(ws, command)}}
      .filter { result => result.failure != null }
    if (failures.length > 0) {
      raise "Deno " + command + " failed:\n" + failures.map { result =>
        "- " + result.path + ": " + (result.failure ?? "")
      }.join("\n")
    }
    null
  }
}

"""
Test files in one Deno project or workspace, keyed by workspace-relative path.
All of them run in one `deno test`: the project or workspace owns the config,
the lockfile and the container, so it is the unit two runs can never share.
"""
type DenoTestFiles @collection {
  """
  Test file paths, relative to the workspace root, in byte order.
  """
  paths: [String!]! @keys

  """
  Test files selected in or out since the collection was discovered.
  """
  delta: CollectionDelta @delta

  """
  Whether the active selection removed test files from this collection.
  """
  narrowed: Boolean! { delta == null or delta!.removedKeys.length > 0 }

  # The directory `deno test` runs from: the project's, or for a workspace
  # member its workspace root's.
  let root: String!

  # What a whole run passes `deno test`: the member's directory relative to
  # root, or "" for everything below root.
  let member: String!

  # Whether directories below the scope hold projects of their own. A run
  # without file arguments would run their tests too, under this project's
  # config, and `--ignore` would replace the config's `exclude`.
  let holdsProjects: Boolean!

  let tool: Deno!

  """
  The test file at this path.
  """
  file(path: String!): DenoTestFile! @get {
    DenoTestFile(path: path)
  }

  """
  Run the selected test files in one `deno test`, then report each failing
  file. A plain helper, not a check: `dagger check` runs one check per file.
  """
  test(ws: Workspace!): Void {
    if (paths.length > 0) {
      let run = results(ws)
      let failures = paths
        .map { p => {{path: p, failure: run.failure(p)}} }
        .filter { result => result.failure != "" }
      if (failures.length > 0) {
        raise "Deno tests failed:\n" + failures.map { result =>
          "- " + result.path + ": " + result.failure
        }.join("\n")
      }
    }
    null
  }

  """
  One `deno test` and its indexed report, shared by every selected test file.
  It depends only on the filtered collection, never on the file asking, so
  every check in a project builds the same command and the engine runs it once.
  """
  let results(ws: Workspace!): DenoTestResults! {
    if (paths.length == 0) { raise "no Deno test files selected in " + root }
    let files = paths.map { p => relativeTo(root, p) }
    # With nothing selected out, run the project the way its own CI would and
    # let deno find its tests; a failure discovery missed still fails a check.
    # Otherwise pass the selected files, which are already in byte order.
    let empty: [String!]! = []
    let targets = if (narrowed or holdsProjects) {
      files.map { f => "./" + f }
    } else if (member == "") {
      empty
    } else {
      [member]
    }
    let executed = tool
      .mounted(ws, root)
      .withEnvVariable("NO_COLOR", "1")
      # A test that uses a Dagger SDK opens its own session; see DenoProject.exec.
      .withEnvVariable("_EXPERIMENTAL_DAGGER_CLI_BIN", "/dev/.dagger/dagger")
      # 511 == 0o777: a base that runs as another user can still write the report.
      .withDirectory("/", directory.withNewDirectory("deno-test", permissions: 511))
      .withExec(
        ["deno", "test", "--permit-no-files"]
          + tool.permissionFlags(false, tool.versionAt(ws, root))
          + tool.testArgs
          + ["--junit-path=/deno-test/report.xml"]
          + targets,
        # A failing test is a result, not an error: raising here would fail
        # every check the same way and lose which file failed.
        expect: ANY,
        redirectStdout: "/deno-test/stdout.log",
        redirectStderr: "/deno-test/stderr.log",
        daggerInDaggerNewSession: true,
      )
    let failFast = tool.testArgs.any { a => a == "--fail-fast" or a.hasPrefix("--fail-fast=") }
    let indexed = tool
      .reportIndexer
      .withDirectory("/deno-test", executed.directory("/deno-test"))
      .withNewFile(
        "/deno-test-selection.json",
        JSON.encode(
          paths.map { p => {{key: p, file: "./" + relativeTo(root, p)}} },
        ),
      )
      .withExec([
        "deno", "run", "--no-config", "--no-lock", "--no-remote", "--allow-read", "--allow-write",
        "/indexer/main.ts",
        "--report", "/deno-test/report.xml",
        "--stdout", "/deno-test/stdout.log",
        "--stderr", "/deno-test/stderr.log",
        "--selection", "/deno-test-selection.json",
        "--exit-code", `${executed.exitCode}`,
        "--fail-fast", if (failFast) { "true" } else { "false" },
        "--output", "/deno-test-results",
      ])
    DenoTestResults(results: indexed.directory("/deno-test-results"), paths: paths)
  }

  """
  A workspace-relative path below root, relative to root.
  """
  let relativeTo(dir: String!, path: String!): String! {
    if (dir == ".") { path } else { path.trimPrefix(dir + "/") }
  }
}

"""
A Deno test file.
"""
type DenoTestFile {
  """
  Test file path, relative to the workspace root.
  """
  path: String!

  """
  Run this test file with `deno test`.

  Every selected file of a project shares one run: `selection` is the
  project's test files as the active selection filtered them, which
  `dagger check` supplies.
  """
  test(ws: Workspace!, selection: DenoTestFiles!): Void @check {
    selection.results(ws).assertPassed(path)
  }
}

# The indexer keeps each result small, however large the report.
type DenoTestResults {
  let results: Directory!
  let paths: [String!]!

  """
  Why a selected test file failed, or "" when it passed.
  """
  let failure(path: String!): String! {
    if (paths.contains(path) == false) { raise "Deno test file is outside the test selection: " + path }
    # The indexer names results by rank in the selection, which is in byte
    # order, so paths never become file names.
    let rank = paths.filter { p => p < path }.length
    results.file(`${rank}`).contents
  }

  let assertPassed(path: String!): Void {
    let failure = failure(path)
    if (failure != "") { raise "Deno tests in " + path + ": " + failure }
    null
  }
}

"""
Partial view of a deno.json / deno.jsonc: the `workspace` array (the list of
monorepo member paths) for discovery, and what it excludes from `deno test`.
"""
type DenoConfig {
  workspace: [String!]! = []
  exclude: [String!]! = []
  test: DenoTestConfig
}

"""
The `test` section of a deno.json / deno.jsonc.
"""
type DenoTestConfig {
  include: [String!]! = []
  exclude: [String!]! = []
}
