# The whole tree shares a single deno.lock and import map, and `deno` fans a
# single command out across every member, so the checks here run one command at
# the root instead of iterating members by hand.
"""
A Deno workspace: a deno.json whose `workspace` array lists member packages.
"""
type DenoWorkspace {
  """
  Workspace root, relative to the Dagger workspace.
  """
  path: String!

  """
  Base container carrying the Deno toolchain, inherited from the Deno root.
  """
  let base: Container!

  """
  Deno version configured on the root, used to gate version-specific flags.
  """
  let version: String!

  """
  The workspace's root deno.json / deno.jsonc file.
  """
  config(ws: Workspace!): File! {
    let dir = ws.directory("/" + path)
    if (dir.glob("deno.jsonc").length > 0) {
      dir.file("deno.jsonc")
    } else {
      dir.file("deno.json")
    }
  }

  """
  The workspace's source directory, members included.
  """
  source(ws: Workspace!): Directory! {
    ws.directory("/" + path, exclude: [".git", "**/node_modules"])
  }

  """
  Container with the Deno toolchain and the whole workspace at the workdir.
  """
  container(ws: Workspace!): Container! {
    base
      .withEnvVariable("DENO_DIR", "/deno-dir")
      .withMountedCache("/deno-dir", cacheVolume("deno-cache"))
      .withDirectory("/src", source(ws))
      .withWorkdir("/src")
  }

  """
  Member directory (relative to the workspace root) for a discovered config path.
  """
  let memberDir(cfgPath: String!): String! {
    let dir = cfgPath.trimSuffix("/deno.jsonc").trimSuffix("/deno.json")
    if (dir == cfgPath) { "." } else { dir }
  }

  """
  The member projects below this workspace root.
  """
  members(ws: Workspace!): [DenoProject!]! {
    # Every directory below the root with its own deno.json / deno.jsonc. Each is
    # a DenoProject that mounts the workspace root, so single-member commands
    # still resolve the shared lockfile and sibling members. This stays a plain
    # list rather than a collection: the workspace's own checks already cover
    # every member, and a collection would run them all again.
    let src = ws.directory(
      "/" + path,
      include: ["**/deno.json", "**/deno.jsonc"],
      exclude: ["**/node_modules/**"],
    )
    (src.glob("**/deno.json") + src.glob("**/deno.jsonc"))
      .map { cfg => memberDir(cfg) }
      .filter { dir => dir != "." }
      .uniq
      .map { dir =>
        DenoProject(
          path: if (path == ".") { dir } else { path + "/" + dir },
          workspaceRoot: path,
          base: base,
          version: version,
        )
      }
  }

  """
  Lint every member of this workspace with `deno lint`.
  """
  lint(ws: Workspace!): Void @check {
    exec(ws, "lint").sync
    null
  }

  """
  Run tests in every member of this workspace with `deno test`.
  """
  test(ws: Workspace!): Void @check {
    exec(ws, "test").sync
    null
  }

  """
  Type-check every member of this workspace with `deno check`.
  """
  typeCheck(ws: Workspace!): Void @check {
    exec(ws, "typeCheck").sync
    null
  }

  """
  Check formatting of every member of this workspace with `deno fmt --check`.
  """
  formatCheck(ws: Workspace!): Void @check {
    exec(ws, "formatCheck").sync
    null
  }

  """
  Format every member of this workspace with `deno fmt`.
  """
  format(ws: Workspace!): Changeset! @generate {
    let dir = cwdDir(ws)
    let before = directory.withDirectory(dir, source(ws))
    let after = directory.withDirectory(dir, formatted(ws))
    after.changes(before)
  }

  """
  The `deno` command line for one of the checks, by function name.
  """
  let args(command: String!): [String!]! {
    if (command == "lint") {
      ["deno", "lint"]
    } else if (command == "test") {
      # Permissions come from each member's deno.json via -P; below Deno 2.5.0
      # (no -P) it falls back to -A.
      let permissionFlag = if (supportsPermissionSets) { "-P" } else { "-A" }
      ["deno", "test", "--permit-no-files", permissionFlag]
    } else if (command == "typeCheck") {
      ["deno", "check", "."]
    } else if (command == "formatCheck") {
      ["deno", "fmt", "--check"]
    } else {
      raise "unknown Deno command: " + command
    }
  }

  let exec(ws: Workspace!, command: String!): Container! {
    container(ws).withExec(args(command))
  }

  """
  Error message from running one of the checks, or null when it passes.
  """
  let failure(ws: Workspace!, command: String!): String {
    { exec(ws, command).sync; null } rescue {
      err: Error => err.message
    }
  }

  """
  This workspace after `deno fmt`.
  """
  let formatted(ws: Workspace!): Directory! {
    container(ws).withExec(["deno", "fmt"]).directory(".")
  }

  """
  This workspace's path relative to the caller: the CLI applies a changeset from
  where the caller stands, not from the workspace root.
  """
  let cwdDir(ws: Workspace!): String! {
    let base = ws.cwd.trimPrefix("/").trimSuffix("/")
    if (path == base) {
      "."
    } else if (base == "" or base == ".") {
      path
    } else {
      path.trimPrefix(base + "/")
    }
  }

  """
  Numeric >= for two non-negative integer strings without leading zeros: the
  longer one is larger, and equal lengths compare lexically.
  """
  let numGte(a: String!, b: String!): Boolean! {
    let da = a.split("").length
    let db = b.split("").length
    if (da != db) { da > db } else { a >= b }
  }

  """
  Whether the configured Deno version supports config-file permission sets and
  the `-P` flag (added in Deno 2.5.0). Compares the version's major.minor.
  """
  let supportsPermissionSets: Boolean! {
    let parts = version.split(".")
    let major = parts[0] ?? "0"
    let minor = if (parts.length > 1) { parts[1] ?? "0" } else { "0" }
    if (numGte(major, "3")) {
      true
    } else if (major == "2") {
      numGte(minor, "5")
    } else {
      false
    }
  }
}
