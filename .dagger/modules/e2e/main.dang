"""
End-to-end checks for the Deno module.

Each check drives the installed `deno` dependency against a small sample project
under `.dagger/modules/e2e/modules`.
"""
type E2e {
  let modulesRoot: String! = ".dagger/modules/e2e/modules"
  let helloPath: String! = modulesRoot + "/hello"
  let fmtDirtyPath: String! = modulesRoot + "/fmt-dirty"
  let withDepsPath: String! = modulesRoot + "/with-deps"
  let permNetPath: String! = modulesRoot + "/perm-net"
  let permAppPath: String! = modulesRoot + "/perm-app"
  let workspacePath: String! = modulesRoot + "/workspace"

  """
  Fail the current check when a condition is false.
  """
  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) {
      raise message
    }
    null
  }

  """
  Run a check, raising its failure. A check called through a dependency comes
  back as a Check that has not run.
  """
  let run(check: Check!): Void {
    # Check.error is not null for a passing check when read from Dang, so ask
    # pass first and read the message only on failure.
    if (check.pass == false) {
      raise check.error.message ?? "check failed"
    }
    null
  }

  """
  Check formatting of every standalone project and Deno workspace in `ws`, the
  way a bare `dagger check` does.
  """
  let formatCheckEverything(ws: Workspace!): Void {
    deno.projects(ws).formatCheck(ws)
    deno.workspaces(ws).formatCheck(ws)
    null
  }

  """
  Return true when a list contains the exact string.
  """
  let contains(values: [String!]!, want: String!): Boolean! {
    values.filter { value => value == want }.length > 0
  }

  """
  Discovery + collection helpers: the projects formatCheck helper fails because the
  discovered fmt-dirty fixture is unformatted, the format helper's changeset
  includes it, and discovery partitions the workspace fixture (a root + members)
  apart from the standalone projects.
  """
  discoveryCheck(ws: Workspace!): Void @check {
    let projects = deno.projects(ws).keys
    assert(contains(projects, helloPath), "projects missed hello: " + projects.join(", "))
    assert(contains(projects, fmtDirtyPath), "projects missed fmt-dirty: " + projects.join(", "))
    assert(contains(projects, withDepsPath), "projects missed with-deps: " + projects.join(", "))
    assert(
      contains(projects, workspacePath) == false and contains(projects, workspacePath + "/add") == false,
      "projects included the Deno workspace or one of its members: " + projects.join(", "),
    )
    assert(
      contains(projects, helloPath + "/nested") == false,
      "projects included a directory without a deno.json",
    )
    # The same selection rules on the real (git) workspace: inside a project's
    # subdirectory, at its root, and from a directory in no project.
    let insideHello = deno.projects(ws.withWorkdir(helloPath + "/nested")).keys
    assert(insideHello == [helloPath], "inside hello/nested: " + insideHello.join(", "))
    let atHello = deno.projects(ws.withWorkdir(helloPath)).keys
    assert(atHello == [helloPath], "at hello: " + atHello.join(", "))
    let fromModules = deno.projects(ws.withWorkdir(modulesRoot)).keys
    assert(fromModules == projects, "from the fixtures directory: " + fromModules.join(", "))
    assert(
      deno.workspaces(ws.withWorkdir(modulesRoot)).keys == [workspacePath],
      "from the fixtures directory: missed the workspace fixture",
    )

    let workspaces = deno.workspaces(ws).keys
    assert(
      workspaces == [workspacePath],
      "workspaces did not find exactly the workspace fixture: " + workspaces.join(", "),
    )

    let formatFailed = {
      deno.projects(ws).formatCheck(ws)
      false
    } rescue true
    assert(formatFailed, "collection formatCheck did not fail; discovery missed the unformatted fixture")

    let changes = deno.projects(ws).format(ws)
    assert(
      contains(changes.modifiedPaths, fmtDirtyPath + "/main.ts"),
      "collection format changeset did not include the discovered fmt-dirty project",
    )
    assert(
      deno.workspaces(ws).format(ws).isEmpty,
      "collection format changed the clean workspace fixture",
    )

    # A standalone project (no workspace ancestor) resolves its workspace root to
    # itself, so it mounts only its own subtree.
    assert(
      deno.project(ws, helloPath).workspaceRoot == helloPath,
      "standalone project should resolve its workspace root to itself",
    )
    null
  }

  """
  A real Deno workspace: its root deno.json `workspace` array is discovered, the
  workspace-wide checks fan out across every member, and members are enumerated.
  """
  workspaceCheck(ws: Workspace!): Void @check {
    let workspace = deno.workspace(ws, workspacePath)
    assert(workspace.path == workspacePath, "workspace lookup returned wrong path: " + workspace.path)

    run(workspace.lint(ws))
    run(workspace.typeCheck(ws))
    run(workspace.formatCheck(ws))
    workspace.test(ws)

    let members = workspace.members(ws).{{path}}.map { m => m.path }
    assert(
      contains(members, workspacePath + "/add") and contains(members, workspacePath + "/util"),
      "workspace members missing add/util: " + members.join(", "),
    )

    null
  }

  """
  A workspace member resolves its workspace root, so a single-member typeCheck /
  test sees the shared config and the sibling `@ws/util` package. Mounting only
  the member subtree (the pre-workspace behavior) would fail this check.
  """
  workspaceMemberCheck(ws: Workspace!): Void @check {
    let add = deno.project(ws, workspacePath + "/add")
    assert(add.path == workspacePath + "/add", "member path wrong: " + add.path)
    assert(
      add.workspaceRoot == workspacePath,
      "member did not resolve its workspace root: " + add.workspaceRoot,
    )
    # The sibling `util` package is also a member of the same workspace root.
    let util = deno.project(ws, workspacePath + "/util")
    assert(
      util.workspaceRoot == workspacePath,
      "sibling member did not resolve its workspace root: " + util.workspaceRoot,
    )

    # These only pass because `add`'s container mounts the workspace root, so the
    # cross-member `@ws/util` import and shared config resolve.
    run(add.typeCheck(ws))
    add.test(ws)
    null
  }

  """
  A workspace with a cross-member import, rooted directly at the discovery cwd so
  the collection helpers run over just this workspace. It guards the partition: the root is
  the only `workspaces` key, fanned out via `deno`'s own workspace resolution,
  while its members are not `projects` keys. If a member leaked into `projects`
  it would be type-checked as a standalone project (mounting only its own
  subtree) and the cross-member `@ws/util` import would fail. Passing all three
  verbs proves both the fan-out and the partition hold.
  """
  workspacePartitionCheck: Void @check {
    let sub = directory
      .withNewFile("deno.json", "{\n  \"workspace\": [\"./add\", \"./util\"]\n}\n")
      .withNewFile("util/deno.json", "{\n  \"name\": \"@ws/util\",\n  \"exports\": \"./mod.ts\"\n}\n")
      .withNewFile("util/mod.ts", "export function tag(): string {\n  return \"util\";\n}\n")
      .withNewFile("add/deno.json", "{\n  \"name\": \"@ws/add\",\n  \"exports\": \"./mod.ts\"\n}\n")
      .withNewFile(
        "add/mod.ts",
        "import { tag } from \"@ws/util\";\n\nexport function describe(n: number): string {\n  return `${tag()}:${n}`;\n}\n",
      )
      .withNewFile(
        "add/mod_test.ts",
        "import { describe } from \"./mod.ts\";\n\nDeno.test(\"describe uses the cross-member util package\", () => {\n  if (describe(3) !== \"util:3\") {\n    throw new Error(\"unexpected describe output\");\n  }\n});\n",
      )
      .asWorkspace
    assert(deno.workspaces(sub).keys == ["."], "workspace root was not the only workspaces key")
    let leaked = deno.projects(sub).keys
    assert(leaked.length == 0, "workspace members leaked into projects: " + leaked.join(", "))
    deno.workspaces(sub).typeCheck(sub)
    deno.workspaces(sub).test(sub)
    deno.workspaces(sub).lint(sub)
    deno.projects(sub).typeCheck(sub)
    deno.projects(sub).test(sub)
    deno.projects(sub).lint(sub)
    null
  }

  """
  A workspace `format` produces one changeset spanning its members: `deno fmt` at
  the root reformats a badly formatted member and the changeset reports that
  member's file. Uses a throwaway workspace so the clean on-disk fixture stays
  clean for the other checks.
  """
  workspaceFormatCheck: Void @check {
    let dirty = directory
      .withNewFile("deno.json", "{\n  \"workspace\": [\"./pkg\"]\n}\n")
      .withNewFile("pkg/deno.json", "{\n  \"name\": \"@ws/pkg\",\n  \"exports\": \"./mod.ts\"\n}\n")
      .withNewFile("pkg/mod.ts", "export function f(a:number){return a}\n")
    let wsDir = dirty.asWorkspace
    let changes = deno.workspace(wsDir, ".").format(wsDir)

    assert(changes.isEmpty == false, "workspace format produced no diff on a badly formatted member")
    assert(
      contains(changes.modifiedPaths, "pkg/mod.ts"),
      "workspace format changeset did not touch the dirty member",
    )
    null
  }

  """
  Discovery is anchored at the caller's location, but the project roots it reports
  stay relative to the workspace root, so they remain usable with every other
  workspace API. Run from inside a member, the enclosing workspace root sits
  *above* the caller — it has to survive being mounted, not just be spelled right,
  since the cross-member `@ws/util` import only resolves from that root.
  """
  subdirDiscoveryCheck: Void @check {
    let member = directory
      .withNewFile("deno.json", "{\n  \"workspace\": [\"./add\", \"./util\"]\n}\n")
      .withNewFile("util/deno.json", "{\n  \"name\": \"@ws/util\",\n  \"exports\": \"./mod.ts\"\n}\n")
      .withNewFile("util/mod.ts", "export function tag(): string {\n  return \"util\";\n}\n")
      .withNewFile("add/deno.json", "{\n  \"name\": \"@ws/add\",\n  \"exports\": \"./mod.ts\"\n}\n")
      .withNewFile(
        "add/mod.ts",
        "import { tag } from \"@ws/util\";\n\nexport function describe(n: number): string {\n  return `${tag()}:${n}`;\n}\n",
      )
      .withNewFile(
        "add/mod_test.ts",
        "import { describe } from \"./mod.ts\";\n\nDeno.test(\"describe uses the cross-member util package\", () => {\n  if (describe(3) !== \"util:3\") {\n    throw new Error(\"unexpected describe output\");\n  }\n});\n",
      )
      .withNewFile("add/dirty.ts", "export function f(a:number){return a}\n")
      .asWorkspace(cwd: "add")

    let project = deno.project(member, ".")
    assert(project.path == "add", "lookup from a member directory returned: " + project.path)
    assert(
      project.workspaceRoot == ".",
      "member did not resolve the workspace root above the caller: " + project.workspaceRoot,
    )

    # Only pass if the root above the caller is what gets mounted.
    run(project.typeCheck(member))
    project.test(member)

    # The collection helpers reach the same member the same way, even though discovery
    # never sees the workspace root from here: the member is a `projects` key
    # whose item still resolves the root above the caller.
    let projects = deno.projects(member)
    assert(projects.keys == ["add"], "keys from a member directory: " + projects.keys.join(", "))
    assert(
      projects.get(key: "add").workspaceRoot == ".",
      "collection item did not resolve the workspace root above the caller: "
        + projects.get(key: "add").workspaceRoot,
    )
    projects.test(member)

    # The CLI applies a generator's changeset from the caller's location, so the
    # member sitting at the cwd is keyed there, not at the workspace root.
    assert(
      contains(projects.format(member).modifiedPaths, "dirty.ts"),
      "collection format from a subdirectory did not key its changeset at the caller's location",
    )
    null
  }

  """
  All happy-path checks pass on a clean, well-formatted project.
  """
  cleanProjectCheck(ws: Workspace!): Void @check {
    let project = deno.project(ws, helloPath)
    run(project.lint(ws))
    run(project.typeCheck(ws))
    run(project.formatCheck(ws))
    project.test(ws)
    null
  }

  """
  Project lookup snaps a nested path to the owning project root, and findUp:false
  keeps an exact root untouched.
  """
  projectLookupCheck(ws: Workspace!): Void @check {
    let nested = deno.project(ws, helloPath + "/nested")
    let exact = deno.project(ws, helloPath, findUp: false)
    assert(nested.path == helloPath, "find-up lookup returned wrong path: " + nested.path)
    assert(exact.path == helloPath, "exact lookup returned wrong path: " + exact.path)
    null
  }

  """
  format returns a non-empty changeset on a badly formatted project, touching
  only that project's files; formatCheck fails on the same project.
  """
  dirtyProjectCheck(ws: Workspace!): Void @check {
    let project = deno.project(ws, fmtDirtyPath)
    let changes = project.format(ws)

    assert(changes.isEmpty == false, "format produced no diff on a badly formatted project")
    assert(
      contains(changes.modifiedPaths, fmtDirtyPath + "/main.ts"),
      "format diff did not modify the project's main.ts",
    )

    let formatCheckFailed = {
      run(project.formatCheck(ws))
      false
    } rescue true
    assert(formatCheckFailed, "formatCheck did not fail on a badly formatted project")
    null
  }

  """
  install adds a working Deno CLI to a bare glibc base image.
  """
  installCheck: Void @check {
    let version = deno
      .install(container.from("debian:stable-slim"))
      .withExec(["deno", "--version"])
      .stdout
    assert(version.contains("deno 2"), "install did not produce a working deno: " + version)
    null
  }

  """
  A project with a jsr dependency type-checks and tests (exercises the dependency
  cache path).
  """
  withDepsCheck(ws: Workspace!): Void @check {
    let project = deno.project(ws, withDepsPath)
    run(project.typeCheck(ws))
    project.test(ws)
    null
  }

  """
  Test permissions come from deno.json, not from Dagger arguments. `test` runs
  `deno test -P`, so a project that declares `test.permissions` in deno.json has
  those permissions granted — and the same container without `-P` fails, proving
  the flag is what activates the config.
  """
  permissionCheck(ws: Workspace!): Void @check {
    let project = deno.project(ws, permNetPath)
    # The module runs `deno test -P`, so net (declared in deno.json) is granted.
    project.test(ws)

    # Without -P, deno refuses config permissions — proves -P is load-bearing.
    let withoutPermissionFlagFailed = {
      project.container(ws).withExec(["deno", "test", "--permit-no-files"]).sync
      false
    } rescue true
    assert(
      withoutPermissionFlagFailed,
      "deno test without -P should fail when permissions live in deno.json",
    )
    null
  }

  """
  On a Deno older than 2.5.0 there is no `-P`, so `test` must fall back to `-A`
  rather than send the unsupported flag. Running `test` with an overridden 2.4.0
  toolchain passes only because of that fallback — sending `-P` would make deno
  2.4.0 fail with "unexpected argument '-P'".
  """
  legacyVersionCheck(ws: Workspace!): Void @check {
    deno(version: "2.4.0").project(ws, helloPath).test(ws)
    null
  }

  """
  `compile` bakes the deno.json default permission set into the binary via `-P`,
  just like `test`. The perm-app fixture declares a top-level `permissions.default`
  with net, so the compiled binary reports net as granted when run — without `-P`
  it would report `prompt`.
  """
  compilePermissionCheck(ws: Workspace!): Void @check {
    let bin = deno.project(ws, permAppPath).compile(ws, entrypoint: "main.ts")
    let output = container
      .from("debian:stable-slim")
      .withFile("/app", bin, permissions: 493)
      .withExec(["/app"])
      .stdout
    assert(
      output.contains("NET:granted"),
      "compiled binary did not bake net permission from deno.json: " + output,
    )
    null
  }

  """
  The `permissions` setting: a project with no permission sets in deno.json
  fails `test` under the default "config" (-P grants nothing) and passes under
  "all" (-A); "none" ignores the config, so the perm-net fixture's net grant is
  gone; anything else is rejected. `compile` follows the same setting.
  """
  permissionsSettingCheck(ws: Workspace!): Void @check {
    let w = directory
      .withNewFile("deno.json", "{}\n")
      .withNewFile(
        "net_test.ts",
        "Deno.test(\"net\", async () => {\n  const s = await Deno.permissions.query({ name: \"net\" });\n  if (s.state !== \"granted\") throw new Error(\"net \" + s.state);\n});\n",
      )
      .withNewFile("main.ts", "const s = await Deno.permissions.query({ name: \"net\" });\nconsole.log(\"NET:\" + s.state);\n")
      .asWorkspace
    assert(
      { deno.project(w, ".").test(w); false } rescue true,
      "config granted net to a project without permission sets",
    )
    deno(permissions: "all").project(w, ".").test(w)
    deno(permissions: "all").projects(w).test(w)
    assert(
      {
        deno(permissions: "none").project(ws, permNetPath).test(ws)
        false
      } rescue true,
      "none still applied the deno.json permission set",
    )

    assert(
      { deno(permissions: "ALL").version; false } rescue true,
      "an unknown permissions mode was accepted",
    )

    let bin = deno(permissions: "all").project(w, ".").compile(
      w,
      entrypoint: "main.ts",
    )
    let output = container
      .from("debian:stable-slim")
      .withFile("/app", bin, permissions: 493)
      .withExec(["/app"])
      .stdout
    assert(output.contains("NET:granted"), "compile with all did not grant net: " + output)
    null
  }

  """
  `testArgs` reach `deno test`: a failing doc example only fails with --doc.
  """
  testArgsCheck: Void @check {
    let w = directory
      .withNewFile("deno.json", "{}\n")
      .withNewFile(
        "mod.ts",
        "/**\n * @example\n * ```ts\n * throw new Error(\"doc example ran\");\n * ```\n */\nexport const x = 1;\n",
      )
      .asWorkspace
    deno.project(w, ".").test(w)
    let failure = { deno(testArgs: ["--doc"]).project(w, ".").test(w); "unexpected success" } rescue {
      err: Error => err.message
    }
    assert(failure.contains("exit code"), "--doc did not run the failing doc example: " + failure)
    null
  }

  """
  `type-check` honours the config's `exclude`, `typeCheckTargets` narrows what it
  checks, and `typeCheckArgs` reach `deno check`.
  """
  typeCheckSettingsCheck: Void @check {
    let files = directory
      .withNewFile("mod.ts", "export const n: number = 1;\n")
      .withNewFile("tools/bad.ts", "export const n: number = \"not a number\";\n")
    let excluded = files.withNewFile("deno.json", "{\n  \"exclude\": [\"tools\"]\n}\n").asWorkspace
    run(deno.project(excluded, ".").typeCheck(excluded))

    let w = files.withNewFile("deno.json", "{}\n").asWorkspace
    assert(
      { run(deno.project(w, ".").typeCheck(w)); false } rescue true,
      "type-check of `.` missed the type error in tools/",
    )
    run(deno(typeCheckTargets: ["mod.ts"]).project(w, ".").typeCheck(w))
    deno(typeCheckTargets: ["mod.ts"]).projects(w).typeCheck(w)
    assert(
      {
        run(
          deno(typeCheckArgs: ["--not-a-deno-flag"]).project(w, ".").typeCheck(w),
        )
        false
      } rescue true,
      "typeCheckArgs did not reach deno check",
    )
    null
  }

  """
  A workspace member's commands run from the workspace root, scoped to the
  member: its tests see the root as their cwd (as `deno test <member>` does),
  and lint, format-check, type-check and format still only cover the member.
  """
  memberScopeCheck: Void @check {
    let base = directory
      .withNewFile("deno.json", "{\n  \"workspace\": [\"./add\", \"./util\"]\n}\n")
      .withNewFile(
        "add/deno.json",
        "{\n  \"name\": \"@ws/add\",\n  \"exports\": \"./mod.ts\",\n  \"test\": { \"permissions\": { \"read\": true } }\n}\n",
      )
      .withNewFile("add/mod.ts", "export const a = 1;\n")
      .withNewFile(
        "add/mod_test.ts",
        "Deno.test(\"runs from the workspace root\", () => {\n  const root = Deno.readTextFileSync(\"deno.json\");\n  if (!root.includes(\"workspace\")) {\n    throw new Error(\"cwd is not the workspace root\");\n  }\n});\n",
      )
      .withNewFile("util/deno.json", "{\n  \"name\": \"@ws/util\",\n  \"exports\": \"./mod.ts\"\n}\n")
      # A dirty, lint-failing, type-broken sibling the member's checks must not see.
      .withNewFile("util/mod.ts", "export function f(a:number){var b: string = a; return b}\n")
    let w = base.asWorkspace
    let add = deno.project(w, "add")
    add.test(w)
    # Control: the same tests from the member's own directory (its container's
    # workdir, where they used to run) can't find the root deno.json.
    assert(
      { add.container(w).withExec(["deno", "test", "-P"]).sync; false } rescue true,
      "the cwd fixture passes from the member directory too, so it proves nothing",
    )
    run(add.lint(w))
    run(add.formatCheck(w))
    run(add.typeCheck(w))
    assert(
      { run(deno.project(w, "util").lint(w)); false } rescue true,
      "the sibling fixture is supposed to fail lint",
    )

    let dirty = base.withNewFile("add/extra.ts", "export function g(b:number){return b}\n").asWorkspace
    let changes = deno.project(dirty, "add").format(dirty)
    assert(
      changes.modifiedPaths == ["add/extra.ts"],
      "member format reached outside the member: " + changes.modifiedPaths.join(", "),
    )
    null
  }

  """
  Configs are classified the way deno reads them. deno.jsonc is parsed as JSONC
  (comments and trailing commas stripped, `//` inside strings kept), so a
  comment that mentions or demonstrates "workspace" doesn't make a workspace;
  in a directory with both files deno.json wins; and a config that doesn't
  parse is keyed as a project, whose checks then fail with deno's error.
  """
  jsoncConfigCheck: Void @check {
    let tree = directory
      # A comment mentioning the word, with a nested project below it.
      .withNewFile(
        "mirror/deno.jsonc",
        "{\n  // Standalone on purpose: not a member of the \"workspace\" at ../packages.\n  \"name\": \"@x/mirror\",\n  \"exports\": \"./mod.ts\",\n}\n",
      )
      .withNewFile("mirror/mod.ts", "export const m = 1;\n")
      .withNewFile("mirror/sub/deno.json", "{}\n")
      # A comment demonstrating the syntax.
      .withNewFile(
        "template/deno.jsonc",
        "{\n  // To become one, add e.g. \"workspace\": [\"./a\", \"./b\"] below.\n  \"name\": \"@x/template\"\n}\n",
      )
      # A genuine JSONC workspace with a block comment and trailing commas.
      .withNewFile("plugins/deno.jsonc", "{\n  /* a genuine workspace */\n  \"workspace\": [\n    \"./a\",\n  ],\n}\n")
      .withNewFile("plugins/a/deno.json", "{\n  \"name\": \"@p/a\",\n  \"exports\": \"./mod.ts\"\n}\n")
      .withNewFile("plugins/a/mod.ts", "export const a = 1;\n")
      # `//` inside a string value must not start a comment.
      .withNewFile(
        "urls/deno.jsonc",
        "{\n  // remote std\n  \"imports\": { \"std/\": \"https://deno.land/std@0.224.0/\" },\n  \"workspace\": [\"./m\"]\n}\n",
      )
      .withNewFile("urls/m/deno.json", "{\n  \"name\": \"@u/m\",\n  \"exports\": \"./mod.ts\"\n}\n")
      .withNewFile("urls/m/mod.ts", "export const u = 1;\n")
      # deno.json declares the workspace; a stale deno.jsonc beside it doesn't.
      .withNewFile("both/deno.json", "{\n  \"workspace\": [\"./core\"]\n}\n")
      .withNewFile("both/deno.jsonc", "{\n  \"name\": \"@stale/both\"\n}\n")
      .withNewFile("both/core/deno.json", "{\n  \"name\": \"@b/core\",\n  \"exports\": \"./mod.ts\"\n}\n")
      .withNewFile("both/core/mod.ts", "export const c = 1;\n")
      .withNewFile("both/fixtures/data.txt", "data\n")
      # ...and the reverse: a stale deno.jsonc declares one, deno.json doesn't.
      .withNewFile("cli/deno.json", "{\n  \"version\": \"from-deno-json\"\n}\n")
      .withNewFile("cli/deno.jsonc", "{\n  \"version\": \"from-deno-jsonc\",\n  \"workspace\": [\"./x\"]\n}\n")
      .withNewFile("cli/mod.ts", "export const cli = 1;\n")
      # Not even JSONC.
      .withNewFile("broken/deno.jsonc", "{\n  \"workspace\": [\"./a\"] ,,\n}\n")
      .withNewFile("broken/mod.ts", "export const b = 1;\n")
    let w = tree.asWorkspace

    let projects = deno.projects(w).keys
    let workspaces = deno.workspaces(w).keys
    assert(
      workspaces.length == 3
        and contains(workspaces, "plugins")
        and contains(workspaces, "urls")
        and contains(workspaces, "both"),
      "workspaces: " + workspaces.join(", "),
    )
    assert(
      projects.length == 5
        and contains(projects, "mirror")
        and contains(projects, "mirror/sub")
        and contains(projects, "template")
        and contains(projects, "cli")
        and contains(projects, "broken"),
      "projects: " + projects.join(", "),
    )

    # The genuine JSONC workspace runs under deno too.
    deno.workspaces(w).subset(keys: ["plugins"]).lint(w)

    # The file deno reads, from the accessors and from inside the workspace.
    assert(
      deno.project(w, "cli").config(w).contents.contains("from-deno-json\""),
      "project config did not return deno.json",
    )
    assert(
      deno.workspace(w, "both").config(w).contents.contains("\"workspace\""),
      "workspace config did not return deno.json",
    )
    let inFixtures = tree.asWorkspace(cwd: "both/fixtures")
    assert(deno.workspaces(inFixtures).keys == ["both"], "from both/fixtures: workspace not found")
    assert(deno.projects(inFixtures).keys.length == 0, "from both/fixtures: the workspace was keyed as a project")
    assert(deno.project(w, "both/core").workspaceRoot == "both", "member did not resolve its workspace through deno.json")

    # The malformed config fails loudly through its checks.
    assert(
      { run(deno.project(w, "broken").lint(w)); false } rescue true,
      "a malformed deno.jsonc passed lint",
    )
    null
  }

  """
  At a project root, only that project and the ones below it are keys: an
  enclosing project is not, though `project` still reaches it by path.
  """
  subdirScopeCheck: Void @check {
    # Ancestor is skipped: dirty root, clean sub. From `/sub`, a project root, the
    # enclosing root is not a key, so the collection helpers pass (sub is clean).
    let dirtyAncestor = directory
      .withNewFile("deno.json", "{}\n")
      .withNewFile("mod.ts", "export function f(a:number){return a}\n")
      .withNewFile("sub/deno.json", "{}\n")
      .withNewFile("sub/mod.ts", "export const ok = 1;\n")
    let fromSub = dirtyAncestor.asWorkspace(cwd: "sub")
    assert(
      deno.projects(fromSub).keys == ["sub"],
      "from /sub: the ancestor root must not be a key: " + deno.projects(fromSub).keys.join(", "),
    )
    assert(
      deno.project(fromSub, "..").path == ".",
      "from /sub: project lookup no longer reaches the ancestor root",
    )
    assert(
      { formatCheckEverything(fromSub); true } rescue false,
      "from /sub: checks must skip the ancestor root, so a dirty ancestor does not fail them",
    )

    # Clean root, dirty sub. From `/sub`, sub is the caller's own project, so the
    # projects formatCheck helper checks it and fails.
    let dirtySub = directory
      .withNewFile("deno.json", "{}\n")
      .withNewFile("mod.ts", "export const ok = 1;\n")
      .withNewFile("sub/deno.json", "{}\n")
      .withNewFile("sub/mod.ts", "export function f(a:number){return a}\n")
    assert(
      { formatCheckEverything(dirtySub.asWorkspace(cwd: "sub")); false } rescue true,
      "from /sub: checks must cover the caller's own project, so a dirty sub fails them",
    )
    null
  }

  """
  Keys follow the caller's location. From inside a project's subdirectory the
  enclosing project is selected, alongside any project below; at a project root
  only it and the projects below are keys; from outside any project, only the
  projects below. Complements `subdirScopeCheck`, whose CWD holds its own config.
  """
  cwdSelectionCheck: Void @check {
    let tree = directory
      .withNewFile("app/deno.json", "{}\n")
      .withNewFile("app/mod.ts", "export function f(a:number){return a}\n")
      .withNewFile("app/src/lib/x.ts", "export function g(b:number){return b}\n")
      .withNewFile("other/deno.json", "{}\n")
      .withNewFile("other/mod.ts", "export const ok = 1;\n")
      .withNewFile("tools/scripts/run.sh", "echo hi\n")

    # At a project root: that project, no siblings.
    let atRoot = deno.projects(tree.asWorkspace(cwd: "app")).keys
    assert(atRoot == ["app"], "at a project root: " + atRoot.join(", "))

    # Inside a project's subdirectory: exactly the enclosing project.
    let inside = tree.asWorkspace(cwd: "app/src")
    let insideKeys = deno.projects(inside).keys
    assert(insideKeys == ["app"], "inside a project's subdirectory: " + insideKeys.join(", "))
    assert(deno.workspaces(inside).keys.length == 0, "inside a standalone project: found a Deno workspace")

    # Its checks run on the whole project, so the dirty mod.ts above the caller
    # fails them...
    assert(
      { formatCheckEverything(inside); false } rescue true,
      "inside a project's subdirectory: its checks did not run on the enclosing project",
    )
    # ...but a changeset applies from where the caller stands, so format keeps
    # only the part of the project under it.
    let changes = deno.projects(inside).format(inside)
    assert(
      changes.modifiedPaths == ["lib/x.ts"],
      "format from inside a project did not scope its changeset to the caller: "
        + changes.modifiedPaths.join(", "),
    )
    assert(
      deno.project(inside, ".").format(inside).modifiedPaths == ["lib/x.ts"],
      "project format from inside a project did not scope its changeset to the caller",
    )

    # Outside any project: the projects below, and none from a directory with none.
    let outside = deno.projects(tree.asWorkspace).keys
    assert(outside == ["app", "other"], "outside any project: " + outside.join(", "))
    let empty = deno.projects(tree.asWorkspace(cwd: "tools")).keys
    assert(empty.length == 0, "from a directory with no project: " + empty.join(", "))

    # From a subdirectory of a project that has a project below it, both are keys.
    let nested = directory
      .withNewFile("deno.json", "{}\n")
      .withNewFile("mod.ts", "export const ok = 1;\n")
      .withNewFile("work/pkg/deno.json", "{}\n")
      .withNewFile("work/pkg/mod.ts", "export const ok = 1;\n")
      .asWorkspace(cwd: "work")
    let nestedKeys = deno.projects(nested).keys
    assert(nestedKeys == [".", "work/pkg"], "enclosing plus nested project: " + nestedKeys.join(", "))
    null
  }

  """
  Inside a Deno workspace member's subdirectory the member project is selected,
  not the whole workspace: the member is the nearest enclosing project, and its
  commands still mount the workspace root for the shared lockfile and siblings.
  From a workspace subdirectory that belongs to no member, the workspace itself
  is selected.
  """
  memberSelectionCheck: Void @check {
    let tree = directory
      .withNewFile("ws/deno.json", "{\n  \"workspace\": [\"./add\", \"./util\"]\n}\n")
      .withNewFile("ws/util/deno.json", "{\n  \"name\": \"@ws/util\",\n  \"exports\": \"./mod.ts\"\n}\n")
      .withNewFile("ws/util/mod.ts", "export function tag(): string {\n  return \"util\";\n}\n")
      .withNewFile("ws/add/deno.json", "{\n  \"name\": \"@ws/add\",\n  \"exports\": \"./mod.ts\"\n}\n")
      .withNewFile(
        "ws/add/mod.ts",
        "import { tag } from \"@ws/util\";\n\nexport function describe(n: number): string {\n  return `${tag()}:${n}`;\n}\n",
      )
      .withNewFile("ws/add/src/extra.ts", "export const extra = 1;\n")
      .withNewFile("ws/docs/README.md", "# docs\n")

    let inMember = tree.asWorkspace(cwd: "ws/add/src")
    let projects = deno.projects(inMember)
    assert(projects.keys == ["ws/add"], "inside a member's subdirectory: " + projects.keys.join(", "))
    assert(
      projects.get(key: "ws/add").workspaceRoot == "ws",
      "member item did not resolve its workspace root: " + projects.get(key: "ws/add").workspaceRoot,
    )
    assert(
      deno.workspaces(inMember).keys.length == 0,
      "inside a member's subdirectory: the whole workspace was selected too",
    )
    # Passes only if the workspace root above the caller is mounted.
    projects.typeCheck(inMember)

    let inDocs = tree.asWorkspace(cwd: "ws/docs")
    assert(deno.workspaces(inDocs).keys == ["ws"], "inside a workspace's non-member subdirectory")
    assert(deno.projects(inDocs).keys.length == 0, "inside a workspace's non-member subdirectory: found projects")
    null
  }

  """
  Projects form a collection keyed by project root. get and list build the
  projects at those keys; subset keeps parent order, rejects unknown and
  duplicate keys, and narrows what get accepts and what the collection helpers run; an
  empty subset is valid and runs nothing.
  """
  projectsCollectionCheck(ws: Workspace!): Void @check {
    let projects = deno.projects(ws)
    let hello = projects.get(key: helloPath)
    assert(hello.path == helloPath, "get did not return the project at its key")
    assert(hello.workspaceRoot == helloPath, "standalone item did not resolve its own root")
    assert(
      projects.list.{{path}}.map { p => p.path } == projects.keys,
      "list did not return one project per key, in key order",
    )

    let parentOrder = projects.keys.filter { p => p == helloPath or p == withDepsPath }
    let pair = projects.subset(keys: [withDepsPath, helloPath])
    assert(pair.keys == parentOrder, "subset did not keep parent order: " + pair.keys.join(", "))

    # fmt-dirty is in the collection but outside the subset, so the subset's
    # helpers pass and its format changes nothing.
    pair.formatCheck(ws)
    pair.typeCheck(ws)
    pair.test(ws)
    assert(pair.format(ws).isEmpty, "subset format touched a project outside the subset")

    let outside = { pair.get(key: fmtDirtyPath).path } rescue {
      err: Error => "rejected"
    }
    assert(outside == "rejected", "get accepted a key outside the subset")

    let unknown = { projects.subset(keys: ["no/such/project"]).keys.join(","); "accepted" } rescue {
      err: Error => "rejected"
    }
    assert(unknown == "rejected", "subset accepted an unknown key")

    let duplicate = {
      projects.subset(keys: [helloPath, helloPath]).keys.join(",")
      "accepted"
    } rescue {
      err: Error => "rejected"
    }
    assert(duplicate == "rejected", "subset accepted a duplicate key")

    let none = projects.subset(keys: [])
    assert(none.keys.length == 0, "empty subset kept keys: " + none.keys.join(", "))
    none.lint(ws)
    assert(none.format(ws).isEmpty, "empty subset formatted something")

    # A subset holding only the dirty project fails and formats only it.
    let dirty = projects.subset(keys: [fmtDirtyPath])
    let failure = { dirty.formatCheck(ws); "unexpected success" } rescue {
      err: Error => err.message
    }
    assert(failure.contains(fmtDirtyPath), "subset formatCheck did not name the dirty project: " + failure)
    let changes = dirty.format(ws)
    assert(
      changes.modifiedPaths == [fmtDirtyPath + "/main.ts"],
      "subset format changed more than the dirty project: " + changes.modifiedPaths.join(", "),
    )
    null
  }

  """
  A collection helper runs every selected project even after one fails, and names each
  failing project.
  """
  collectionFailuresCheck: Void @check {
    let w = directory
      .withNewFile("a/deno.json", "{}\n")
      .withNewFile("a/mod.ts", "export function f(a:number){return a}\n")
      .withNewFile("b/deno.json", "{}\n")
      .withNewFile("b/mod.ts", "export const ok = 1;\n")
      .withNewFile("c/deno.json", "{}\n")
      .withNewFile("c/mod.ts", "export function g(c:number){return c}\n")
      .asWorkspace
    let projects = deno.projects(w)
    assert(projects.keys == ["a", "b", "c"], "unexpected keys: " + projects.keys.join(", "))
    let failure = { projects.formatCheck(w); "unexpected success" } rescue {
      err: Error => err.message
    }
    assert(
      failure.contains("- a:") and failure.contains("- c:") and failure.contains("- b:") == false,
      "collection formatCheck did not name exactly the failing projects: " + failure,
    )
    let changes = projects.format(w)
    assert(
      contains(changes.modifiedPaths, "a/mod.ts")
        and contains(changes.modifiedPaths, "c/mod.ts")
        and changes.modifiedPaths.length == 2,
      "collection format did not produce one changeset over the dirty projects: "
        + changes.modifiedPaths.join(", "),
    )
    null
  }

  """
  Deno workspaces form a collection keyed by workspace root, with the same get,
  subset and helper behavior as projects.
  """
  workspacesCollectionCheck(ws: Workspace!): Void @check {
    let workspaces = deno.workspaces(ws)
    assert(workspaces.get(key: workspacePath).path == workspacePath, "get did not return the workspace at its key")
    assert(
      workspaces.list.{{path}}.map { w => w.path } == workspaces.keys,
      "list did not return one workspace per key, in key order",
    )
    let one = workspaces.subset(keys: [workspacePath])
    one.lint(ws)
    one.typeCheck(ws)
    one.test(ws)
    one.formatCheck(ws)

    let unknown = { workspaces.subset(keys: [helloPath]).keys.join(","); "accepted" } rescue {
      err: Error => "rejected"
    }
    assert(unknown == "rejected", "workspaces subset accepted a standalone project")

    let none = workspaces.subset(keys: [])
    none.test(ws)
    assert(none.format(ws).isEmpty, "empty workspaces subset formatted something")

    # Two workspaces side by side: the helper runs both and names the dirty one.
    let two = directory
      .withNewFile("x/deno.json", "{\n  \"workspace\": [\"./pkg\"]\n}\n")
      .withNewFile("x/pkg/deno.json", "{\n  \"name\": \"@x/pkg\",\n  \"exports\": \"./mod.ts\"\n}\n")
      .withNewFile("x/pkg/mod.ts", "export const ok = 1;\n")
      .withNewFile("y/deno.json", "{\n  \"workspace\": [\"./pkg\"]\n}\n")
      .withNewFile("y/pkg/deno.json", "{\n  \"name\": \"@y/pkg\",\n  \"exports\": \"./mod.ts\"\n}\n")
      .withNewFile("y/pkg/mod.ts", "export function f(a:number){return a}\n")
      .asWorkspace
    let pair = deno.workspaces(two)
    assert(pair.keys == ["x", "y"], "unexpected workspace keys: " + pair.keys.join(", "))
    assert(deno.projects(two).keys.length == 0, "workspace members leaked into projects")
    let failure = { pair.formatCheck(two); "unexpected success" } rescue {
      err: Error => err.message
    }
    assert(
      failure.contains("- y:") and failure.contains("- x:") == false,
      "workspaces collection formatCheck did not name exactly the dirty workspace: " + failure,
    )
    pair.subset(keys: ["x"]).formatCheck(two)
    assert(
      pair.format(two).modifiedPaths == ["y/pkg/mod.ts"],
      "workspaces collection format did not produce one changeset over the dirty workspace",
    )
    null
  }

  """
  Test files are found the way `deno test` walks a directory: test.*, *_test.*
  and *.test.* with a JavaScript or TypeScript extension, hidden directories
  included, node_modules and the config's `exclude`, `test.exclude` and
  `test.include` followed. A standalone project leaves a nested project's files
  to it; a workspace covers its members, minus what their configs exclude.
  """
  testFilesDiscoveryCheck: Void @check {
    let ok = "Deno.test(\"ok\", () => {});\n"
    let w = directory
      .withNewFile(
        "app/deno.json",
        "{\n  \"exclude\": [\"dist\"],\n  \"test\": { \"exclude\": [\"e2e/\", \"**/*.slow_test.ts\"] }\n}\n",
      )
      .withNewFile("app/a_test.ts", ok)
      .withNewFile("app/b.test.mjs", ok)
      .withNewFile("app/test.tsx", ok)
      .withNewFile("app/.hidden/h_test.ts", ok)
      .withNewFile("app/lib/helper.ts", "export const helper = 1;\n")
      # Test-named files that register no test of their own are no checks.
      .withNewFile("app/empty_test.ts", "export {};\n")
      .withNewFile("app/imports_test.ts", "import \"./lib/helper.ts\";\n")
      .withNewFile("app/foo.spec.ts", failingTest("a spec file"))
      .withNewFile("app/latest.ts", "export const latest = 1;\n")
      .withNewFile("app/dist/x_test.ts", failingTest("an excluded file"))
      .withNewFile("app/e2e/y_test.ts", failingTest("a test-excluded file"))
      .withNewFile("app/sub/z.slow_test.ts", failingTest("a glob-excluded file"))
      .withNewFile("app/node_modules/pkg/n_test.ts", failingTest("a node_modules file"))
      .withNewFile("app/nested/deno.json", "{}\n")
      .withNewFile("app/nested/n_test.ts", failingTest("a nested project's test"))
      .withNewFile("inc/deno.json", "{\n  \"test\": { \"include\": [\"src/\"] }\n}\n")
      .withNewFile("inc/src/s_test.ts", ok)
      .withNewFile("inc/other_test.ts", failingTest("a file outside test.include"))
      .withNewFile("mono/deno.json", "{\n  \"workspace\": [\"./a\"]\n}\n")
      .withNewFile(
        "mono/a/deno.json",
        "{\n  \"name\": \"@m/a\",\n  \"exports\": \"./mod.ts\",\n  \"test\": { \"exclude\": [\"skip_test.ts\"] }\n}\n",
      )
      .withNewFile("mono/a/mod.ts", "export const a = 1;\n")
      .withNewFile("mono/a/a_test.ts", ok)
      .withNewFile("mono/a/skip_test.ts", failingTest("a member-excluded file"))
      .withNewFile("mono/root_test.ts", ok)
      .asWorkspace
    let app = deno.project(w, "app").testFiles(w)
    assert(
      app.keys == ["app/.hidden/h_test.ts", "app/a_test.ts", "app/b.test.mjs", "app/test.tsx"],
      "app test files: " + app.keys.join(", "),
    )
    let nested = deno.project(w, "app/nested").testFiles(w).keys
    assert(nested == ["app/nested/n_test.ts"], "nested project test files: " + nested.join(", "))
    let inc = deno.project(w, "inc").testFiles(w).keys
    assert(inc == ["inc/src/s_test.ts"], "test.include: " + inc.join(", "))
    let mono = deno.workspace(w, "mono").testFiles(w)
    assert(mono.keys == ["mono/a/a_test.ts", "mono/root_test.ts"], "workspace test files: " + mono.keys.join(", "))
    let member = deno.project(w, "mono/a").testFiles(w).keys
    assert(member == ["mono/a/a_test.ts"], "member test files: " + member.join(", "))
    assert(app.get(key: "app/a_test.ts").path == "app/a_test.ts", "get did not return the file at its key")

    # The plain helpers run the discovered files and nothing else.
    app.test(w)
    mono.test(w)
    deno.project(w, "inc").testFiles(w).test(w)
    null
  }

  """
  The collection's plain `test` helper runs its files in one `deno test` and
  names exactly the files that failed; a subset runs only its own.
  """
  testFilesHelperCheck: Void @check {
    let w = directory
      .withNewFile("deno.json", "{}\n")
      .withNewFile("a_test.ts", "Deno.test(\"a\", () => {});\n")
      .withNewFile("b_test.ts", "Deno.test(\"b\", () => { throw new Error(\"b failed on purpose\"); });\n")
      .withNewFile("c_test.ts", "Deno.test(\"c\", () => {});\n")
      .asWorkspace
    let files = deno.project(w, ".").testFiles(w)
    let failure = { files.test(w); "unexpected success" } rescue {
      err: Error => err.message
    }
    assert(
      failure.contains("- b_test.ts:")
        and failure.contains("b failed on purpose")
        and failure.contains("- a_test.ts:") == false
        and failure.contains("- c_test.ts:") == false,
      "test helper did not name exactly the failing file: " + failure,
    )
    files.subset(keys: ["a_test.ts", "c_test.ts"]).test(w)
    null
  }

  """
  The test report indexer's own unit tests.
  """
  testReportIndexerCheck(ws: Workspace!): Void @check {
    container
      .from("denoland/deno:alpine-2.9.3")
      .withoutEntrypoint
      .withEnvVariable("DENO_NO_UPDATE_CHECK", "1")
      .withDirectory("/src", ws.directory("/helpers/deno-test-report"))
      .withWorkdir("/src")
      .withExec(["deno", "test", "--no-config", "--no-lock", "--no-remote", "main_test.ts"])
      .withExec(["deno", "lint", "--no-config", "main.ts", "main_test.ts"])
      .withExec(["deno", "fmt", "--check", "--no-config", "main.ts", "main_test.ts"])
      .sync
    null
  }

  # A test file whose test fails, saying what ran.
  let failingTest(what: String!): String! {
    "Deno.test(\"x\", () => { throw new Error(\"" + what + " ran\"); });\n"
  }

  # Only the unindented CHECKS header counts: nested test summaries can be
  # right while Dagger attributes the checks wrongly.
  let checkSummaryMatches(output: String!, passed: Int!, failed: Int!): Boolean! {
    let headers = output.split("\n").filter { line =>
      line.hasPrefix("CHECKS ") or line.hasPrefix("== CHECKS ==")
    }
    let expected = (if (failed > 0) { ["✘", `${failed}`, "failed"] } else { [] })
      + (if (passed > 0) { ["✔", `${passed}`, "passed"] } else { [] })
    headers.length == 1 and headers[0]!
      .trimPrefix("== ")
      .trimPrefix("CHECKS")
      .trimPrefix(" ==")
      .trimSpace
      .split(" ")
      .filter { word => word != "" } == expected
  }

  # `dagger check` in a fixture with this module installed, through the
  # engine-provided CLI in a session of its own. Direct Dang calls do not apply
  # the engine's filtered collection view; only the CLI does.
  let daggerCheck(
    ws: Workspace!,
    fixture: Directory!,
    args: [String!]!,
    settings: String! = "",
  ): Container! {
    container
      .from("alpine:3.23")
      # Workspace.search runs ripgrep on the client, which here is this
      # container: discovery searches for configs declaring a workspace.
      .withExec(["apk", "add", "--no-cache", "ripgrep"])
      .withEnvVariable("NO_COLOR", "1")
      .withDirectory(
        "/source",
        ws.directory("/", exclude: [".git", ".dagger/modules/e2e/modules"]),
      )
      .withDirectory("/work", fixture)
      .withNewFile("/work/.git/HEAD", "ref: refs/heads/main\n")
      .withNewFile("/work/dagger.toml", "[modules.deno]\nsource = \"/source\"\n" + settings)
      .withWorkdir("/work")
      .withExec(["/dev/.dagger/dagger"] + args, expect: ANY, daggerInDaggerNewSession: true)
  }

  let selectedCheck(
    ws: Workspace!,
    fixture: Directory!,
    args: [String!]!,
    passed: Int!,
    failed: Int! = 0,
    messages: [String!]! = [],
    settings: String! = "",
  ): Void {
    let result = daggerCheck(
      ws,
      fixture,
      ["--progress=report", "check", "--generated=false"] + args,
      settings: settings,
    )
    let output = result.stdout + result.stderr
    assert((result.exitCode == 0) == (failed == 0), "unexpected check exit status:\n" + output)
    assert(checkSummaryMatches(output, passed, failed), "unexpected Dagger check totals:\n" + output)
    messages.map { message =>
      assert(output.contains(message), "missing " + message + ":\n" + output)
    }
    null
  }

  let selectionOk: String! = "Deno.test(\"ok\", () => {});\n"
  let selectionExcluded: String! = "Deno.test(\"other\", () => { throw new Error(\"excluded test ran\"); });\n"

  # Two standalone projects and a workspace, each with two test files to
  # select and one whose test fails if it runs.
  let selectionFixture: Directory! {
    ["p1", "p2"].reduce(
      directory
        .withNewFile("ws/deno.json", "{\n  \"workspace\": [\"./m\"]\n}\n")
        .withNewFile("ws/m/deno.json", "{\n  \"name\": \"@w/m\",\n  \"exports\": \"./mod.ts\"\n}\n")
        .withNewFile("ws/m/mod.ts", "export const m = 1;\n")
        .withNewFile("ws/m/a_test.ts", selectionOk)
        .withNewFile("ws/m/b_test.ts", selectionOk)
        .withNewFile("ws/m/other_test.ts", selectionExcluded),
    ) { fixture, p =>
      fixture
        .withNewFile(p + "/deno.json", "{}\n")
        .withNewFile(p + "/a_test.ts", selectionOk)
        .withNewFile(p + "/b_test.ts", selectionOk)
        .withNewFile(p + "/other_test.ts", selectionExcluded)
    }
  }

  let projectSelection: [String!]! {
    ["p1/a_test.ts", "p1/b_test.ts", "p2/a_test.ts", "p2/b_test.ts"].map { f => "--deno-projects-test-file=" + f }
  }

  """
  Selected test files in two projects pass, and the excluded ones never run.
  """
  selectedTestsCheck(ws: Workspace!): Void @check {
    selectedCheck(ws, selectionFixture, projectSelection, passed: 4)
  }

  """
  Selected test files in a workspace's member pass, and the excluded one never runs.
  """
  selectedWorkspaceTestsCheck(ws: Workspace!): Void @check {
    selectedCheck(
      ws,
      selectionFixture,
      ["--deno-workspaces-test-file=ws/m/a_test.ts", "--deno-workspaces-test-file=ws/m/b_test.ts"],
      passed: 2,
    )
  }

  """
  Every selected file of a project shares one `deno test`: four checks in two
  projects run two, and an unnarrowed project runs without file arguments.
  """
  selectedSharedRunCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture
      .withoutFile("p2/other_test.ts")
      # Unique content, so that this check's runs are not cached by another's.
      .withNewFile("p1/marker_test.ts", "// shared run check\n" + selectionOk)
    let args = projectSelection + ["--deno-projects-test-file=p1/marker_test.ts"]
    let result = daggerCheck(ws, fixture, ["-vvv", "--progress=plain", "check", "--generated=false"] + args)
    let output = result.stdout + result.stderr
    assert(result.exitCode == 0, "the selected checks failed:\n" + output)
    let runs = output.split("\n").filter { line => line.contains("withExec deno test --permit-no-files") and line.contains("DONE") == false }
    assert(runs.length == 2, "expected one deno test per project, got:\n" + runs.join("\n"))
    assert(
      runs.any { line => line.contains("./a_test.ts ./b_test.ts ./marker_test.ts") },
      "the narrowed project did not pass its selected files:\n" + runs.join("\n"),
    )
    assert(
      runs.any { line => line.contains("--junit-path=/deno-test/report.xml (") },
      "the unnarrowed project did not run as a whole:\n" + runs.join("\n"),
    )
    null
  }

  """
  A failing test fails only its own file's check.
  """
  selectedFailureCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile(
      "p1/a_test.ts",
      "Deno.test(\"broken\", () => { throw new Error(\"selected failure\"); });\n",
    )
    selectedCheck(ws, fixture, projectSelection, passed: 3, failed: 1, messages: ["selected failure"])
  }

  """
  A type error stops `deno test` before any test runs, so it fails every
  selected file of that project, and only that project.
  """
  selectedTypeErrorCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile(
      "p2/a_test.ts",
      "const n: number = \"not a number\";\nDeno.test(\"typed\", () => {});\n",
    )
    selectedCheck(ws, fixture, projectSelection, passed: 2, failed: 2, messages: ["TS2322"])
  }

  """
  A module that throws outside any test fails only its own file's check.
  """
  selectedUncaughtCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile(
      "p1/b_test.ts",
      "Deno.test(\"registered\", () => {});\nthrow new Error(\"top-level failure\");\n",
    )
    selectedCheck(ws, fixture, projectSelection, passed: 3, failed: 1, messages: ["top-level failure"])
  }

  """
  A failing test an imported helper registers is reported in the helper, but
  fails only the check of the test file that ran it.
  """
  selectedHelperFailureCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture
      .withNewFile("p1/helper.ts", "Deno.test(\"shared\", () => { throw new Error(\"helper failure\"); });\n")
      .withNewFile("p1/a_test.ts", "import \"./helper.ts\";\n" + selectionOk)
    selectedCheck(
      ws,
      fixture,
      projectSelection,
      passed: 3,
      failed: 1,
      messages: ["shared (registered in ./helper.ts)", "helper failure"],
    )
  }

  """
  With --parallel in testArgs, deno prints no module headers: a file whose
  only test comes from a helper still counts as run, from the prefix on that
  test's line, and a test-named file that registers no test is no check.
  """
  selectedParallelCheck(ws: Workspace!): Void @check {
    let fixture = directory
      .withNewFile("p/deno.json", "{}\n")
      .withNewFile("p/a_test.ts", selectionOk)
      .withNewFile("p/helper.ts", "Deno.test(\"from helper\", () => {});\n")
      .withNewFile("p/b_test.ts", "// Its Deno.test comes from the helper.\nimport \"./helper.ts\";\n")
      .withNewFile("p/empty_test.ts", "export {};\n")
    selectedCheck(
      ws,
      fixture,
      ["--deno-projects-test-files"],
      passed: 2,
      settings: "\n[modules.deno.settings]\ntestArgs = [\"--parallel\"]\n",
    )
  }

  """
  A project whose config deno can't parse fails its own test files' checks,
  with deno's error naming the file; the other project's pass.
  """
  selectedBrokenConfigCheck(ws: Workspace!): Void @check {
    selectedCheck(
      ws,
      selectionFixture.withNewFile("p2/deno.json", "{ broken\n"),
      projectSelection,
      passed: 2,
      failed: 2,
      messages: ["p2/deno.json"],
    )
  }

  """
  Listing test files runs no deno and no test: a testArgs that breaks every
  run still lists every file.
  """
  listingRunsNoToolCheck(ws: Workspace!): Void @check {
    let result = daggerCheck(
      ws,
      selectionFixture,
      ["-vvv", "--progress=plain", "check", "-l", "--all", "-f=cli"],
      settings: "\n[modules.deno.settings]\ntestArgs = [\"--not-a-deno-flag\"]\n",
    )
    let output = result.stdout + result.stderr
    assert(result.exitCode == 0, "listing failed:\n" + output)
    ["--deno-projects-test-file=p1/a_test.ts", "--deno-projects-test-file=p2/other_test.ts", "--deno-workspaces-test-file=ws/m/b_test.ts"].map { key =>
      assert(output.contains(key), "listing missed " + key + ":\n" + output)
    }
    let execs = output.split("\n").filter { line => line.contains("withExec deno") or line.contains("exec deno ") }
    assert(execs.length == 0, "listing ran deno:\n" + execs.join("\n"))
    null
  }


  """
  An unnarrowed project runs as a whole, so a failing test file deno runs but
  discovery does not list (one `test.include` names) fails its checks; a
  narrowed selection leaves it out.
  """
  selectedWholeRunCheck(ws: Workspace!): Void @check {
    let fixture = directory
      .withNewFile("p/deno.json", "{\n  \"test\": { \"include\": [\"a_test.ts\", \"b_test.ts\", \"extra.ts\"] }\n}\n")
      .withNewFile("p/a_test.ts", selectionOk)
      .withNewFile("p/b_test.ts", selectionOk)
      .withNewFile("p/extra.ts", "Deno.test(\"extra\", () => { throw new Error(\"undiscovered failure\"); });\n")
    selectedCheck(
      ws,
      fixture,
      ["--deno-projects-test-files"],
      passed: 0,
      failed: 2,
      messages: ["failures outside the selected test files: ./extra.ts", "undiscovered failure"],
    )
    selectedCheck(ws, fixture, ["--deno-projects-test-file=p/a_test.ts"], passed: 1)
  }

  """
  A selected file that deno never runs fails, saying so, rather than passing
  with nothing behind it.
  """
  selectedNotRunCheck(ws: Workspace!): Void @check {
    selectedCheck(
      ws,
      selectionFixture.withNewFile("p1/slow/c_test.ts", selectionOk),
      projectSelection + ["--deno-projects-test-file=p1/slow/c_test.ts"],
      passed: 4,
      failed: 1,
      messages: ["./slow/c_test.ts did not run"],
      # deno skips an ignored directory even below a file argument.
      settings: "\n[modules.deno.settings]\ntestArgs = [\"--ignore=slow\"]\n",
    )
  }

}
